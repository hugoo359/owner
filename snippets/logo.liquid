{%- comment -%}
  Logo aus den Theme-Einstellungen, sonst Shopname als Schriftzug (optional mit Sanduhr-Zeichen).
  Parameter: size ('sm' | 'lg'), eager (bool)
{%- endcomment -%}
{%- if settings.logo != blank -%}
  {%- assign w2 = settings.logo_width | times: 2 -%}
  {%- if eager -%}
    {{ settings.logo | image_url: width: w2 | image_tag: class: 'logo-img', alt: shop.name, loading: 'eager', width: settings.logo_width }}
  {%- else -%}
    {{ settings.logo | image_url: width: w2 | image_tag: class: 'logo-img', alt: shop.name, loading: 'lazy', width: settings.logo_width }}
  {%- endif -%}
{%- else -%}
  <span class="logo logo--{{ size | default: 'sm' }}">
    {%- if settings.logo_emblem -%}{% render 'emblem', size: 14, class: 'logo-emblem' %}{%- endif -%}
    <span class="logo-word">{{ shop.name }}</span>
  </span>
{%- endif -%}
