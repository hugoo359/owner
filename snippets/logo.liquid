{%- comment -%} Gibt das Logo-Bild aus den Theme-Einstellungen aus, sonst den Shopnamen als Schriftzug. {%- endcomment -%}
{%- if settings.logo != blank -%}
  {%- assign w2 = settings.logo_width | times: 2 -%}
  {{ settings.logo | image_url: width: w2 | image_tag: class: 'logo-img', alt: shop.name, loading: 'eager', width: settings.logo_width }}
{%- else -%}
  <span class="logo">{{ shop.name }}</span>
{%- endif -%}
