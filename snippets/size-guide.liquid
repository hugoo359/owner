{%- comment -%}
  Größenberater-Pop-up:
  1) „Find your size“: Herr/Dame, Körpergröße, Gewicht, Passform -> Größenempfehlung
  2) „Size chart“: drehbare Modelle (T-Shirt, Jogger), Maße und Tabelle
  Parameter: product, tops (Text), bottoms (Text), size_offset (Zahl, Passform des Produkts)
{%- endcomment -%}
{%- liquid
  assign t = product.type | append: ' ' | append: product.title | downcase
  assign start = 'tops'
  if t contains 'hose' or t contains 'jogger' or t contains 'pants' or t contains 'short' or t contains 'legging' or t contains 'jeans' or t contains 'denim' or t contains 'sweatpant'
    assign start = 'bottoms'
  endif
-%}
<div id="sizeguide" class="layer sg-layer" hidden data-sg data-start="{{ start }}" data-offset="{{ size_offset | default: 0 }}">
  <div class="backdrop" data-close="sizeguide"></div>
  <div class="sg-modal" role="dialog" aria-modal="true" aria-labelledby="SgTitle">
    <div class="sg-head">
      <h2 id="SgTitle">FIND YOUR SIZE</h2>
      <button type="button" class="sg-x" data-close="sizeguide" aria-label="Close">{% render 'icon', icon: 'close' %}</button>
    </div>

    <div class="sg-views" role="tablist">
      <button type="button" role="tab" class="on" aria-selected="true" data-sg-view="finder">Size finder</button>
      <button type="button" role="tab" aria-selected="false" data-sg-view="chart">Size chart</button>
    </div>

    {%- comment -%} ---------- Größenrechner ---------- {%- endcomment -%}
    <div class="sgf" data-sg-pane="finder">
      <form class="sgf-form" data-sgf-form novalidate>
        <fieldset class="sgf-block">
          <legend class="sgf-step"><span>1</span>I'm shopping for</legend>
          <div class="sgf-gender" role="radiogroup" aria-label="Men or women">
            <button type="button" role="radio" aria-checked="false" data-sgf-gender="men">
              <svg width="26" height="26" viewBox="0 0 26 26" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="11" cy="15" r="6.5"/><path d="M15.6 10.4L22 4M16.5 4H22v5.5"/></svg>
              <span>Men</span>
            </button>
            <button type="button" role="radio" aria-checked="false" data-sgf-gender="women">
              <svg width="26" height="26" viewBox="0 0 26 26" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="13" cy="9.5" r="6.5"/><path d="M13 16v8M9 20.5h8"/></svg>
              <span>Women</span>
            </button>
          </div>
        </fieldset>

        <fieldset class="sgf-block">
          <legend class="sgf-step"><span>2</span>Your height</legend>
          <div class="sgf-field">
            <input type="number" id="SgfHeight" inputmode="numeric" min="140" max="215" step="1" placeholder="178" data-sgf-in="h" aria-label="Height in centimetres">
            <span>cm</span>
          </div>
          <input type="range" class="sgf-range" min="140" max="215" step="1" value="178" data-sgf-range="h" aria-label="Height slider">
        </fieldset>

        <fieldset class="sgf-block">
          <legend class="sgf-step"><span>3</span>Your weight</legend>
          <div class="sgf-field">
            <input type="number" id="SgfWeight" inputmode="numeric" min="35" max="180" step="1" placeholder="75" data-sgf-in="w" aria-label="Weight in kilograms">
            <span>kg</span>
          </div>
          <input type="range" class="sgf-range" min="35" max="180" step="1" value="75" data-sgf-range="w" aria-label="Weight slider">
        </fieldset>

        <fieldset class="sgf-block">
          <legend class="sgf-step"><span>4</span>Preferred fit</legend>
          <div class="sg-fit" role="radiogroup" aria-label="Preferred fit">
            <button type="button" role="radio" aria-checked="false" data-sgf-fit="-1">Tighter</button>
            <button type="button" role="radio" aria-checked="true" data-sgf-fit="0" class="on">Regular</button>
            <button type="button" role="radio" aria-checked="false" data-sgf-fit="1">Looser</button>
          </div>
        </fieldset>

        <p class="sgf-err" data-sgf-err role="alert"></p>
        <button type="submit" class="atc sgf-go"><span class="atc-label">Calculate my size</span></button>
      </form>

      <div class="sgf-result" data-sgf-result aria-live="polite">
        <div class="sgf-empty" data-sgf-empty>
          <svg width="54" height="54" viewBox="0 0 54 54" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M27 12a4 4 0 1 1 4 4c-2 0-4 1.5-4 3.5V22M27 22L6 36.5c-1.6 1.1-.8 3.5 1.1 3.5h39.8c1.9 0 2.7-2.4 1.1-3.5L27 22z"/></svg>
          <p>Tell us a little about yourself and we'll calculate the size that fits you best.</p>
        </div>
        <div class="sgf-out" data-sgf-out hidden>
          <span class="sgf-kicker">We recommend size</span>
          <strong class="sgf-size" data-sgf-size>M</strong>
          <p class="sgf-why" data-sgf-why></p>
          <div class="sgf-scale" data-sgf-scale aria-hidden="true"></div>
          <p class="sgf-alt" data-sgf-alt hidden></p>
          <button type="button" class="atc sgf-apply" data-sgf-apply><span class="atc-label" data-sgf-apply-label>Select size M</span></button>
          <button type="button" class="link-u sgf-edit" data-sgf-edit>Edit my details</button>
          <p class="sg-note">This recommendation is an estimate based on average body proportions. If in doubt, compare the garment measurements in the size chart with a piece that fits you well.</p>
        </div>
      </div>
    </div>

    <div class="sg-chartpane" data-sg-pane="chart" hidden>
    <div class="sg-bar">
      <div class="sg-tabs" role="tablist">
        <button type="button" role="tab" data-sg-tab="tops">Tops</button>
        <button type="button" role="tab" data-sg-tab="bottoms">Pants &amp; Joggers</button>
        <span class="sg-ink" aria-hidden="true"></span>
      </div>
      <div class="sg-unit" role="group" aria-label="Unit">
        <button type="button" data-sg-unit="cm" class="on">cm</button>
        <button type="button" data-sg-unit="in">inch</button>
        <span class="sg-unit-knob" aria-hidden="true"></span>
      </div>
    </div>

    <div class="sg-body">
      <div class="sg-stage" data-sg-stage>
        <div class="sg-tilt" data-sg-tilt>

          {%- comment -%} ---------- T-Shirt ---------- {%- endcomment -%}
          <svg class="sg-model" data-sg-model="tops" viewBox="0 0 400 440" aria-label="T-shirt with measurements" role="img">
            <defs>
              <linearGradient id="sgTBody" x1="0" x2="1" y1="0" y2="0">
                <stop offset="0" stop-color="#c9c9c9"/><stop offset=".2" stop-color="#ebebeb"/><stop offset=".5" stop-color="#f8f8f8"/><stop offset=".8" stop-color="#e4e4e4"/><stop offset="1" stop-color="#bfbfbf"/>
              </linearGradient>
              <linearGradient id="sgTSleeveL" x1="0" x2="1" y1="0" y2="0"><stop offset="0" stop-color="#b6b6b6"/><stop offset="1" stop-color="#e2e2e2"/></linearGradient>
              <linearGradient id="sgTSleeveR" x1="0" x2="1" y1="0" y2="0"><stop offset="0" stop-color="#e2e2e2"/><stop offset="1" stop-color="#b2b2b2"/></linearGradient>
              <linearGradient id="sgTShade" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#000" stop-opacity="0"/><stop offset=".75" stop-color="#000" stop-opacity="0"/><stop offset="1" stop-color="#000" stop-opacity=".08"/></linearGradient>
              <marker id="sgCapT" viewBox="-1 -6 2 12" markerWidth="2" markerHeight="12" orient="auto" markerUnits="userSpaceOnUse"><path d="M0,-6 L0,6" stroke="currentColor" stroke-width="2"/></marker>
            </defs>
            <g class="sg-garment">
              <path d="M128 70 L60 108 L84 170 L130 150 Z" fill="url(#sgTSleeveL)"/>
              <path d="M272 70 L340 108 L316 170 L270 150 Z" fill="url(#sgTSleeveR)"/>
              <path d="M70 104 L93 165" stroke="#000" stroke-opacity=".07" stroke-width="2"/>
              <path d="M330 104 L307 165" stroke="#000" stroke-opacity=".07" stroke-width="2"/>
              <path d="M128 70 Q160 58 172 56 Q200 80 228 56 Q240 58 272 70 L276 150 L280 352 Q200 364 120 352 L124 150 Z" fill="url(#sgTBody)"/>
              <path d="M128 70 Q160 58 172 56 Q200 80 228 56 Q240 58 272 70 L276 150 L280 352 Q200 364 120 352 L124 150 Z" fill="url(#sgTShade)"/>
              <path d="M174 58 Q200 82 226 58 Q213 64 200 64 Q187 64 174 58 Z" fill="#a4a4a4"/>
              <path d="M170 56 Q200 86 230 56" fill="none" stroke="#cdcdcd" stroke-width="6" stroke-linecap="round"/>
              <path d="M128 72 L130 150 M272 72 L270 150" stroke="#000" stroke-opacity=".08" stroke-width="1.5"/>
              <path d="M150 200 Q160 252 152 306 M252 212 Q244 262 254 314 M186 280 Q200 304 214 280" fill="none" stroke="#000" stroke-opacity=".05" stroke-width="3" stroke-linecap="round"/>
              <path d="M121 340 Q200 352 279 340" fill="none" stroke="#000" stroke-opacity=".08" stroke-width="2"/>
            </g>
            <g class="sg-m" data-m="0" style="color: currentColor">
              <line class="sg-line" x1="236" y1="62" x2="236" y2="356" pathLength="1" marker-start="url(#sgCapT)" marker-end="url(#sgCapT)"/>
              <g class="sg-pill" transform="translate(236 270)"><rect x="-34" y="-12" width="68" height="24" rx="12"/><text class="sg-l" x="-21" y="4">A</text><text class="sg-v" x="7" y="4" data-sg-val="0">–</text></g>
            </g>
            <g class="sg-m" data-m="1">
              <line class="sg-line" x1="126" y1="176" x2="274" y2="176" pathLength="1" marker-start="url(#sgCapT)" marker-end="url(#sgCapT)"/>
              <g class="sg-pill" transform="translate(178 176)"><rect x="-34" y="-12" width="68" height="24" rx="12"/><text class="sg-l" x="-21" y="4">B</text><text class="sg-v" x="7" y="4" data-sg-val="1">–</text></g>
            </g>
            <g class="sg-m" data-m="2">
              <line class="sg-line" x1="274" y1="72" x2="330" y2="140" pathLength="1" marker-start="url(#sgCapT)" marker-end="url(#sgCapT)"/>
              <g class="sg-pill" transform="translate(348 88)"><rect x="-34" y="-12" width="68" height="24" rx="12"/><text class="sg-l" x="-21" y="4">C</text><text class="sg-v" x="7" y="4" data-sg-val="2">–</text></g>
            </g>
          </svg>

          {%- comment -%} ---------- Jogger ---------- {%- endcomment -%}
          <svg class="sg-model" data-sg-model="bottoms" viewBox="0 0 400 440" aria-label="Joggers with measurements" role="img">
            <defs>
              <linearGradient id="sgJLegL" x1="0" x2="1" y1="0" y2="0"><stop offset="0" stop-color="#bdbdbd"/><stop offset=".45" stop-color="#ececec"/><stop offset=".75" stop-color="#f4f4f4"/><stop offset="1" stop-color="#d4d4d4"/></linearGradient>
              <linearGradient id="sgJLegR" x1="0" x2="1" y1="0" y2="0"><stop offset="0" stop-color="#d4d4d4"/><stop offset=".25" stop-color="#f4f4f4"/><stop offset=".55" stop-color="#ececec"/><stop offset="1" stop-color="#b9b9b9"/></linearGradient>
              <linearGradient id="sgJBand" x1="0" x2="1" y1="0" y2="0"><stop offset="0" stop-color="#cfcfcf"/><stop offset=".5" stop-color="#f1f1f1"/><stop offset="1" stop-color="#c9c9c9"/></linearGradient>
              <pattern id="sgRib" width="7" height="10" patternUnits="userSpaceOnUse"><path d="M3.5 0 V10" stroke="#000" stroke-opacity=".06" stroke-width="1.5"/></pattern>
              <marker id="sgCapJ" viewBox="-1 -6 2 12" markerWidth="2" markerHeight="12" orient="auto" markerUnits="userSpaceOnUse"><path d="M0,-6 L0,6" stroke="currentColor" stroke-width="2"/></marker>
            </defs>
            <g class="sg-garment">
              <path d="M116 76 L200 76 L200 150 L188 396 L124 396 Q108 300 112 200 Z" fill="url(#sgJLegL)"/>
              <path d="M200 76 L284 76 Q292 200 276 396 L212 396 L200 150 Z" fill="url(#sgJLegR)"/>
              <path d="M200 78 L200 150" stroke="#000" stroke-opacity=".09" stroke-width="1.5"/>
              <path d="M128 86 Q146 112 142 142 M272 86 Q254 112 258 142" fill="none" stroke="#000" stroke-opacity=".1" stroke-width="2"/>
              <path d="M132 360 Q156 372 182 360 M132 376 Q156 386 182 376 M218 360 Q244 372 268 360 M218 376 Q244 386 268 376" fill="none" stroke="#000" stroke-opacity=".06" stroke-width="2"/>
              <path d="M150 220 Q156 280 146 330 M252 220 Q246 280 256 330" fill="none" stroke="#000" stroke-opacity=".05" stroke-width="3" stroke-linecap="round"/>
              <path d="M124 394 L188 394 L186 424 L126 424 Z" fill="#d2d2d2"/><path d="M124 394 L188 394 L186 424 L126 424 Z" fill="url(#sgRib)"/>
              <path d="M212 394 L276 394 L274 424 L214 424 Z" fill="#cfcfcf"/><path d="M212 394 L276 394 L274 424 L214 424 Z" fill="url(#sgRib)"/>
              <path d="M118 38 L282 38 L284 76 L116 76 Z" fill="url(#sgJBand)"/><path d="M118 38 L282 38 L284 76 L116 76 Z" fill="url(#sgRib)"/>
              <path d="M194 76 Q190 100 186 124 M206 76 Q210 100 214 122" fill="none" stroke="#8f8f8f" stroke-width="3" stroke-linecap="round"/>
              <rect x="182" y="122" width="7" height="12" rx="2" fill="#6f6f6f"/><rect x="211" y="120" width="7" height="12" rx="2" fill="#6f6f6f"/>
            </g>
            <g class="sg-m" data-m="0">
              <line class="sg-line" x1="118" y1="57" x2="282" y2="57" pathLength="1" marker-start="url(#sgCapJ)" marker-end="url(#sgCapJ)"/>
              <g class="sg-pill" transform="translate(150 57)"><rect x="-34" y="-12" width="68" height="24" rx="12"/><text class="sg-l" x="-21" y="4">A</text><text class="sg-v" x="7" y="4" data-sg-val="0">–</text></g>
            </g>
            <g class="sg-m" data-m="1">
              <line class="sg-line" x1="90" y1="38" x2="90" y2="424" pathLength="1" marker-start="url(#sgCapJ)" marker-end="url(#sgCapJ)"/>
              <g class="sg-pill" transform="translate(64 240)"><rect x="-34" y="-12" width="68" height="24" rx="12"/><text class="sg-l" x="-21" y="4">B</text><text class="sg-v" x="7" y="4" data-sg-val="1">–</text></g>
            </g>
            <g class="sg-m" data-m="2">
              <line class="sg-line" x1="208" y1="158" x2="220" y2="392" pathLength="1" marker-start="url(#sgCapJ)" marker-end="url(#sgCapJ)"/>
              <g class="sg-pill" transform="translate(246 280)"><rect x="-34" y="-12" width="68" height="24" rx="12"/><text class="sg-l" x="-21" y="4">C</text><text class="sg-v" x="7" y="4" data-sg-val="2">–</text></g>
            </g>
          </svg>
        </div>
        <div class="sg-floor" aria-hidden="true"></div>
        <p class="sg-hint"><svg width="16" height="12" viewBox="0 0 16 12" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M1 6h14M4 3L1 6l3 3M12 3l3 3-3 3"/></svg>Drag to rotate</p>
      </div>

      <div class="sg-panel">
        <p class="sg-label">Select size</p>
        <div class="sg-sizes" data-sg-sizes></div>
        <ul class="sg-legend" data-sg-legend></ul>

        <div class="sg-table-wrap"><table class="sg-table" data-sg-table></table></div>

        <button type="button" class="atc sg-apply" data-sg-apply><span class="atc-label" data-sg-apply-label>Apply size</span></button>
      </div>
    </div>
    </div>
  </div>
  <script type="application/json" data-sg-json>{ "tops": {{ tops | json }}, "bottoms": {{ bottoms | json }} }</script>
</div>
