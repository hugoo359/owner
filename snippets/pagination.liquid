<nav class="pagination" aria-label="Seiten">
  {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">← Zurück</a>{%- endif -%}
  {%- for part in paginate.parts -%}
    {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- elsif part.title == paginate.current_page -%}<span class="current">{{ part.title }}</span>{%- else -%}<span>{{ part.title }}</span>{%- endif -%}
  {%- endfor -%}
  {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Weiter →</a>{%- endif -%}
</nav>
