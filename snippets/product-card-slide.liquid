{%- comment -%}
  Produktkarte für den Slider (linksbündig, Hochformat).
  Parameter: product, badge ('none' | 'tag' | 'all'), badge_label, subtitle ('options' | 'type' | 'vendor' | 'none')
{%- endcomment -%}
{%- liquid
  assign size_option = nil
  assign size_idx = 0
  for option in product.options_with_values
    assign n = option.name | downcase
    if n contains 'größe' or n contains 'grösse' or n contains 'groesse' or n contains 'size'
      assign size_option = option
      assign size_idx = forloop.index0
    endif
  endfor

  assign badge_text = ''
  if product.compare_at_price > product.price
    assign pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price
    assign badge_text = '-' | append: pct | append: ' %'
  elsif badge == 'all'
    assign badge_text = badge_label
  elsif badge == 'tag'
    assign tags_down = product.tags | join: ',' | downcase | split: ','
    if tags_down contains 'neu' or tags_down contains 'new'
      assign badge_text = badge_label
    endif
  endif

  assign sub = ''
  case subtitle
    when 'type'
      assign sub = product.type
    when 'vendor'
      assign sub = product.vendor
    when 'options'
      unless product.has_only_default_variant
        assign v = product.selected_or_first_available_variant
        for option in product.options_with_values
          if forloop.index0 == size_idx and size_option
            continue
          endif
          assign val = v.options[forloop.index0]
          if sub == ''
            assign sub = val
          else
            assign sub = sub | append: ' · ' | append: val
          endif
        endfor
      endunless
  endcase
-%}
<div class="card slide-card" data-reveal>
  <div class="card-media">
    <a href="{{ product.url }}" class="media{% if product.media.size > 1 %} has-hover{% endif %}" tabindex="-1" aria-hidden="true" draggable="false">
      {%- if product.featured_media -%}
        {{ product.featured_media | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 1100px) 20vw, (min-width: 700px) 33vw, 50vw', widths: '360, 540, 720, 900', class: 'main-img', alt: product.title, draggable: 'false' }}
        {%- if product.media.size > 1 -%}
          {{ product.media[1] | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 1100px) 20vw, (min-width: 700px) 33vw, 50vw', widths: '360, 540, 720, 900', class: 'hover-img', alt: '', draggable: 'false' }}
        {%- endif -%}
      {%- else -%}
        {{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </a>
    {%- if badge_text != '' -%}<span class="badge{% if badge_text contains '%' %} badge--sale{% endif %}">{{ badge_text }}</span>{%- endif -%}

    {%- if settings.quick_add and product.available and size_option -%}
      <div class="qa" aria-label="Quick add">
        <span class="qa-label">Select size</span>
        <div class="qa-sizes">
          {%- for value in size_option.values -%}
            {%- assign vname = value.name | default: value -%}
            {%- assign vid = nil -%}
            {%- for v in product.variants -%}
              {%- if v.available and v.options[size_idx] == vname -%}{%- assign vid = v.id -%}{%- break -%}{%- endif -%}
            {%- endfor -%}
            {%- if vid -%}<button type="button" data-qa-variant="{{ vid }}">{{ vname }}</button>{%- else -%}<button type="button" disabled>{{ vname }}</button>{%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
  <a href="{{ product.url }}" class="card-info" draggable="false">
    <h3>{{ product.title }}</h3>
    {%- if sub != blank -%}<p class="card-sub">{{ sub }}</p>{%- endif -%}
    <div class="price">
      {{ product.price | money }}
      {%- if product.compare_at_price > product.price %} <s>{{ product.compare_at_price | money }}</s>{% endif -%}
    </div>
  </a>
</div>
