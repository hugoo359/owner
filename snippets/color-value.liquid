{%- comment -%} Liefert einen CSS-Farbwert zu einem Farbnamen (Theme-Einstellung "Farbzuordnung"). {%- endcomment -%}
{%- liquid
  assign key = name | downcase | strip
  assign out = key | handleize | replace: '-', ''
  assign lines = settings.color_map | newline_to_br | split: '<br />'
  for line in lines
    assign parts = line | strip | split: ':'
    assign k = parts[0] | downcase | strip
    if k == key and parts[1] != blank
      assign out = parts[1] | strip
    endif
  endfor
  echo out
-%}
