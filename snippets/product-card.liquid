{%- comment -%}
  Produktkarte für Kollektion, Suche und Empfehlungen.
  Parameter: product, optional only_id (ID der einzigen Variante, die gezeigt wird, z. B. 100 ml)
  und only_label (angezeigte Größe, wenn das Produkt keine Größen-Option hat)
{%- endcomment -%}
{%- liquid
  assign size_option = nil
  assign size_idx = 0
  assign f_colors = ''
  for option in product.options_with_values
    assign n = option.name | downcase
    if n contains 'größe' or n contains 'grösse' or n contains 'groesse' or n contains 'size' or n contains 'inhalt' or n contains 'füllmenge' or n contains 'volum'
      assign size_option = option
      assign size_idx = forloop.index0
    elsif n contains 'farbe' or n contains 'color' or n contains 'colour'
      for value in option.values
        assign vname = value.name | default: value
        assign f_colors = f_colors | append: '|' | append: vname
      endfor
    endif
  endfor
  if product.metafields.custom.color_name != blank
    assign f_colors = f_colors | append: '|' | append: product.metafields.custom.color_name.value
  endif

  # Daten für die Schnellfilter der Kollektionsseite (funktionieren auch ohne Search & Discovery).
  # Werte werden mit | getrennt und klein geschrieben verglichen.
  assign f_sizes = ''
  if size_option
    for v in product.variants
      if v.available
        assign f_sizes = f_sizes | append: '|' | append: v.options[size_idx]
      endif
    endfor
  endif

  # Grundpreis zur angezeigten (günstigsten) Variante
  assign unit_variant = product.selected_or_first_available_variant
  if product.price_varies
    for v in product.variants
      if v.price == product.price
        assign unit_variant = v
        break
      endif
    endfor
  endif

  # Was die Karte zeigt: ganzes Produkt oder nur eine Variante (z. B. nur 100 ml)
  assign cv = nil
  if only_id != blank
    for v in product.variants
      assign vid = v.id | append: ''
      if vid == only_id
        assign cv = v
        break
      endif
    endfor
  endif
  assign card_url = product.url
  assign card_media = product.featured_media
  assign card_price = product.price
  assign card_compare = product.compare_at_price
  assign price_from = product.price_varies
  assign card_avail = product.available
  if cv
    assign card_url = cv.url
    if cv.featured_media
      assign card_media = cv.featured_media
    endif
    assign card_price = cv.price
    assign card_compare = cv.compare_at_price
    assign price_from = false
    assign card_avail = cv.available
    assign unit_variant = cv
    assign cv_label = only_label
    if size_option
      assign cv_label = cv.options[size_idx]
    endif
    assign f_sizes = ''
    if cv.available
      assign f_sizes = '|' | append: cv_label
    endif
  endif
  assign hover_media = product.media[1]
  if hover_media and card_media and hover_media.id == card_media.id
    assign hover_media = product.media[0]
  endif
-%}
{%- capture unit_out -%}{% render 'unit-price', variant: unit_variant %}{%- endcapture -%}
{%- capture f_families -%}{% render 'scent-families', product: product %}{%- endcapture -%}
<div class="card" data-reveal
  data-f-type="{{ product.type | downcase | escape }}"
  data-f-families="{{ f_families | strip | downcase | prepend: '|' | append: '|' | escape }}"
  data-f-colors="{{ f_colors | downcase | append: '|' | escape }}"
  data-f-sizes="{{ f_sizes | downcase | append: '|' | escape }}"
  data-f-avail="{{ card_avail }}">
  <div class="card-media">
    <a href="{{ card_url }}" class="media{% if product.media.size > 1 %} has-hover{% endif %}" tabindex="-1" aria-hidden="true">
      {%- if card_media -%}
        {{ card_media | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 1100px) 25vw, 50vw', widths: '300, 450, 600, 900', class: 'main-img', alt: product.title }}
        {%- if product.media.size > 1 -%}
          {{ hover_media | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 1100px) 25vw, 50vw', widths: '300, 450, 600, 900', class: 'hover-img', alt: '' }}
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </a>

    {%- if settings.quick_add and card_avail -%}
      <div class="qa" aria-label="Schnell hinzufügen">
        {%- if cv -%}
          <button type="button" class="qa-single" data-qa-variant="{{ cv.id }}">+ {{ cv_label }} in den Warenkorb</button>
        {%- elsif size_option -%}
          <span class="qa-label">Größe wählen</span>
          <div class="qa-sizes">
            {%- for value in size_option.values -%}
              {%- assign vname = value.name | default: value -%}
              {%- assign vid = nil -%}
              {%- for v in product.variants -%}
                {%- if v.available and v.options[size_idx] == vname -%}{%- assign vid = v.id -%}{%- break -%}{%- endif -%}
              {%- endfor -%}
              {%- if vid -%}
                <button type="button" data-qa-variant="{{ vid }}">{{ vname }}</button>
              {%- else -%}
                <button type="button" disabled>{{ vname }}</button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- elsif product.has_only_default_variant -%}
          <button type="button" class="qa-single" data-qa-variant="{{ product.first_available_variant.id }}">+ In den Warenkorb</button>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <a href="{{ card_url }}" class="card-info">
    <h3>{{ product.title }}</h3>
    <div class="sz">
      {%- if cv -%}
        {%- if cv.available -%}
          {%- if cv_label != blank -%}{% render 'icon', icon: 'cart-sm' %}<span>{{ cv_label }}</span>{%- endif -%}
        {%- else -%}
          <span>{{ settings.sold_out_text | default: "Ausverkauft" | upcase }}</span>
        {%- endif -%}
      {%- elsif size_option -%}
        {%- capture sizes_out -%}
          {%- for value in size_option.values -%}
            {%- assign vname = value.name | default: value -%}
            {%- for v in product.variants -%}
              {%- if v.available and v.options[size_idx] == vname -%}<span>{{ vname }}</span>{%- break -%}{%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        {%- endcapture -%}
        {% render 'icon', icon: 'cart-sm' %}
        {%- if sizes_out != blank -%}{{ sizes_out }}{%- else -%}<span>{{ settings.sold_out_text | default: "Ausverkauft" | upcase }}</span>{%- endif -%}
      {%- elsif product.available == false -%}
        <span>{{ settings.sold_out_text | default: "Ausverkauft" | upcase }}</span>
      {%- endif -%}
    </div>
    <div class="price">
      {%- if price_from -%}ab {% endif -%}
      {{ card_price | money_with_currency }}
      {%- if card_compare > card_price %} <s>{{ card_compare | money_with_currency }}</s>{% endif -%}
      {%- if unit_out != blank -%}<span class="unit">{{ unit_out }}</span>{%- endif -%}
    </div>
  </a>
</div>
