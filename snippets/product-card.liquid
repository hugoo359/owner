{%- liquid
  assign size_option = nil
  assign size_idx = 0
  assign f_colors = ''
  for option in product.options_with_values
    assign n = option.name | downcase
    if n contains 'größe' or n contains 'grösse' or n contains 'groesse' or n contains 'size'
      assign size_option = option
      assign size_idx = forloop.index0
    elsif n contains 'farbe' or n contains 'color' or n contains 'colour'
      for value in option.values
        assign vname = value.name | default: value
        assign f_colors = f_colors | append: '|' | append: vname
      endfor
    endif
  endfor
  if product.metafields.custom.color_name != blank
    assign f_colors = f_colors | append: '|' | append: product.metafields.custom.color_name.value
  endif

  # Daten für die Schnellfilter der Kollektionsseite (funktionieren auch ohne Search & Discovery).
  # Werte werden mit | getrennt und klein geschrieben verglichen.
  assign f_sizes = ''
  if size_option
    for v in product.variants
      if v.available
        assign f_sizes = f_sizes | append: '|' | append: v.options[size_idx]
      endif
    endfor
  endif
-%}
<div class="card" data-reveal
  data-f-type="{{ product.type | downcase | escape }}"
  data-f-colors="{{ f_colors | downcase | append: '|' | escape }}"
  data-f-sizes="{{ f_sizes | downcase | append: '|' | escape }}"
  data-f-avail="{{ product.available }}">
  <div class="card-media">
    <a href="{{ product.url }}" class="media{% if product.media.size > 1 %} has-hover{% endif %}" tabindex="-1" aria-hidden="true">
      {%- if product.featured_media -%}
        {{ product.featured_media | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 1100px) 25vw, 50vw', widths: '300, 450, 600, 900', class: 'main-img', alt: product.title }}
        {%- if product.media.size > 1 -%}
          {{ product.media[1] | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 1100px) 25vw, 50vw', widths: '300, 450, 600, 900', class: 'hover-img', alt: '' }}
        {%- endif -%}
      {%- else -%}
        {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </a>

    {%- if settings.quick_add and product.available -%}
      <div class="qa" aria-label="Quick add">
        {%- if size_option -%}
          <span class="qa-label">Select size</span>
          <div class="qa-sizes">
            {%- for value in size_option.values -%}
              {%- assign vname = value.name | default: value -%}
              {%- assign vid = nil -%}
              {%- for v in product.variants -%}
                {%- if v.available and v.options[size_idx] == vname -%}{%- assign vid = v.id -%}{%- break -%}{%- endif -%}
              {%- endfor -%}
              {%- if vid -%}
                <button type="button" data-qa-variant="{{ vid }}">{{ vname }}</button>
              {%- else -%}
                <button type="button" disabled>{{ vname }}</button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- elsif product.has_only_default_variant -%}
          <button type="button" class="qa-single" data-qa-variant="{{ product.first_available_variant.id }}">+ Add to cart</button>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <a href="{{ product.url }}" class="card-info">
    <h3>{{ product.title }}</h3>
    <div class="sz">
      {%- if size_option -%}
        {%- capture sizes_out -%}
          {%- for value in size_option.values -%}
            {%- assign vname = value.name | default: value -%}
            {%- for v in product.variants -%}
              {%- if v.available and v.options[size_idx] == vname -%}<span>{{ vname }}</span>{%- break -%}{%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        {%- endcapture -%}
        {% render 'icon', icon: 'cart-sm' %}
        {%- if sizes_out != blank -%}{{ sizes_out }}{%- else -%}<span>{{ settings.sold_out_text | default: "Sold out" | upcase }}</span>{%- endif -%}
      {%- elsif product.available == false -%}
        <span>{{ settings.sold_out_text | default: "Sold out" | upcase }}</span>
      {%- endif -%}
    </div>
    <div class="price">
      {%- if product.price_varies -%}from {% endif -%}
      {{ product.price | money_with_currency }}
      {%- if product.compare_at_price > product.price %} <s>{{ product.compare_at_price | money_with_currency }}</s>{% endif -%}
    </div>
  </a>
</div>
