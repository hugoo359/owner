<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,400;0,500;0,600;0,700;0,800;1,900&display=swap">
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <style>:root{--bg:{{ settings.color_background }};--ink:{{ settings.color_text }};--accent:{{ settings.color_accent }};--ok:{{ settings.color_success }};--logo-w:{{ settings.logo_width }}px}</style>
  {{ content_for_header }}
</head>
<body class="template-password">
  <main id="MainContent">{{ content_for_layout }}</main>
</body>
</html>
