<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_background }}">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
  {%- endif -%}
  <title>
    {{ page_title }}
    {%- if current_tags %} – {{ current_tags | join: ', ' }}{% endif -%}
    {%- if current_page != 1 %} – Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} | {{ shop.name }}{% endunless -%}
  </title>
  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,400;0,500;0,600;0,700;0,800;1,900&display=swap">

  <script>
    document.documentElement.classList.add('js'{% if settings.anim_reveal %}, 'js-anim'{% endif %}{% if settings.respect_reduced_motion %}, 'rm-respect'{% endif %});
    setTimeout(function () { if (!window.__themeReady) document.documentElement.classList.remove('js-anim'); }, 3500);
  </script>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <style>
    :root{
      --bg: {{ settings.color_background }};
      --ink: {{ settings.color_text }};
      --accent: {{ settings.color_accent }};
      --ok: {{ settings.color_success }};
      --logo-w: {{ settings.logo_width }}px;
    }
  </style>

  <script>
    window.theme = {
      moneyFormat: {{ shop.money_with_currency_format | json }},
      routes: {
        root: {{ routes.root_url | json }},
        cart: {{ routes.cart_url | json }},
        cartAdd: {{ routes.cart_add_url | json }},
        cartChange: {{ routes.cart_change_url | json }},
        predictiveSearch: {{ routes.predictive_search_url | json }}
      },
      settings: {
        pageTransitions: {{ settings.anim_page_transitions | json }},
        flyToCart: {{ settings.anim_fly_to_cart | json }},
        respectReducedMotion: {{ settings.respect_reduced_motion | json }}
      },
      strings: {
        added: "Added",
        addToCart: "Add to cart",
        soldOut: "Sold out",
        unavailable: "Unavailable",
        chooseSize: "Please select a size.",
        inStock: {{ 'In stock.' | json }},
        noResults: "No results"
      }
    };
  </script>
  <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

  {{ content_for_header }}
</head>

<body class="template-{{ template.name }}">
  <a class="skip-link" href="#MainContent">Skip to content</a>

  {% sections 'header-group' %}

  <main id="MainContent" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {% render 'search-overlay' %}
  {% section 'cart-drawer' %}

  <div class="toast" id="Toast" role="status" hidden></div>
</body>
</html>
