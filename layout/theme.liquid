<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_background }}">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
  {%- endif -%}
  <title>
    {{ page_title }}
    {%- if current_tags %} – {{ current_tags | join: ', ' }}{% endif -%}
    {%- if current_page != 1 %} – {{ 'general.page' | t: page: current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} | {{ shop.name }}{% endunless -%}
  </title>
  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}
  {% render 'meta-tags' %}

  {{ 'cormorant-garamond-latin-400-normal.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  {{ 'jost-latin-400-normal.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  {% render 'theme-styles' %}
  {{ 'theme.css' | asset_url | stylesheet_tag }}

  <script>
    document.documentElement.classList.replace('no-js', 'js');
    {%- if settings.anim_reveal %}document.documentElement.classList.add('js-anim');{% endif %}
    {%- if settings.respect_reduced_motion %}document.documentElement.classList.add('rm-respect');{% endif %}
    setTimeout(function () { if (!window.__themeReady) document.documentElement.classList.remove('js-anim'); }, 3500);
  </script>

  <script>
    window.theme = {
      moneyFormat: {% if settings.currency_code_enabled %}{{ shop.money_with_currency_format | json }}{% else %}{{ shop.money_format | json }}{% endif %},
      routes: {
        root: {{ routes.root_url | json }},
        cart: {{ routes.cart_url | json }},
        cartAdd: {{ routes.cart_add_url | json }},
        cartChange: {{ routes.cart_change_url | json }},
        predictiveSearch: {{ routes.predictive_search_url | json }}
      },
      settings: {
        pageTransitions: {{ settings.anim_page_transitions | json }},
        flyToCart: {{ settings.anim_fly_to_cart | json }},
        respectReducedMotion: {{ settings.respect_reduced_motion | json }}
      },
      strings: {
        addToCart: {{ 'product.add_to_cart' | t | json }},
        soldOut: {{ 'product.sold_out' | t | json }},
        comingSoon: {{ 'product.coming_soon' | t | json }},
        unavailable: {{ 'product.unavailable' | t | json }},
        inStock: {{ 'product.in_stock' | t | json }},
        added: {{ 'product.added' | t | json }},
        adding: {{ 'cart.adding' | t | json }},
        cartError: {{ 'cart.error' | t | json }},
        cookieUnavailable: {{ 'footer.cookie_unavailable' | t | json }},
        loadError: {{ 'general.load_error' | t | json }}
      }
    };
  </script>
  <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

  {{ content_for_header }}
</head>

<body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}--{{ template.suffix }}{% endif %}">
  <a class="skip-link" href="#MainContent">{{ 'general.skip_to_content' | t }}</a>

  {% sections 'header-group' %}

  <main id="MainContent" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {% render 'search-overlay' %}
  {% section 'cart-drawer' %}

  <div class="toast" id="Toast" role="status" hidden></div>
</body>
</html>
