<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_background }}">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
  {%- endif -%}
  <title>
    {{ page_title }}
    {%- if current_tags %} – {{ current_tags | join: ', ' }}{% endif -%}
    {%- if current_page != 1 %} – {{ 'general.page' | t: page: current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} | {{ shop.name }}{% endunless -%}
  </title>
  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}
  {% render 'meta-tags' %}
  {% render 'fonts' %}

  <script>
    document.documentElement.classList.add('js'{% if settings.anim_reveal %}, 'js-anim'{% endif %}{% if settings.respect_reduced_motion %}, 'rm-respect'{% endif %});
    setTimeout(function () { if (!window.__themeReady) document.documentElement.classList.remove('js-anim'); }, 3500);
  </script>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <style>
    :root{
      --bg: {{ settings.color_background }};
      --ink: {{ settings.color_text }};
      --accent: {{ settings.color_accent }};
      --ok: {{ settings.color_success }};
      --logo-w: {{ settings.logo_width }}px;
    }
  </style>

  <script>
    window.theme = {
      locale: {{ request.locale.iso_code | json }},
      moneyFormat: {{ shop.money_with_currency_format | json }},
      routes: {
        root: {{ routes.root_url | json }},
        cart: {{ routes.cart_url | json }},
        cartAdd: {{ routes.cart_add_url | json }},
        cartChange: {{ routes.cart_change_url | json }},
        predictiveSearch: {{ routes.predictive_search_url | json }}
      },
      settings: {
        pageTransitions: {{ settings.anim_page_transitions | json }},
        flyToCart: {{ settings.anim_fly_to_cart | json }},
        respectReducedMotion: {{ settings.respect_reduced_motion | json }}
      },
      strings: {
        added: {{ 'product.added' | t | json }},
        addToCart: {{ 'product.add_to_cart' | t | json }},
        soldOut: {{ 'product.sold_out' | t | json }},
        unavailable: {{ 'product.unavailable' | t | json }},
        chooseSize: {{ 'product.choose_size' | t | json }},
        error: {{ 'general.error' | t | json }},
        cookieUnavailable: {{ 'general.cookie_unavailable' | t | json }},
        adding: {{ 'cart.adding' | t | json }},
        addError: {{ 'cart.add_error' | t | json }},
        loadMoreError: {{ 'collection.load_more_error' | t | json }},
        copied: {{ 'gift_card.copied' | t | json }},
        sf: {
          men: {{ 'size_finder.men' | t | json }},
          women: {{ 'size_finder.women' | t | json }},
          fit: {
            '-1': {{ 'size_finder.fit_tighter_lower' | t | json }},
            '0': {{ 'size_finder.fit_regular_lower' | t | json }},
            '1': {{ 'size_finder.fit_looser_lower' | t | json }}
          },
          weRecommend: {{ 'size_finder.we_recommend_size' | t | json }},
          selectSize: {{ 'size_finder.select_size' | t | json }},
          sizeSoldOut: {{ 'size_finder.size_sold_out' | t | json }},
          basedOn: {{ 'size_finder.based_on' | t | json }},
          runsLarge: {{ 'size_finder.runs_large' | t | json }},
          runsSmall: {{ 'size_finder.runs_small' | t | json }},
          betweenLooser: {{ 'size_finder.between_looser' | t | json }},
          betweenCloser: {{ 'size_finder.between_closer' | t | json }},
          errGender: {{ 'size_finder.error_gender' | t | json }},
          errHeight: {{ 'size_finder.error_height' | t | json }},
          errWeight: {{ 'size_finder.error_weight' | t | json }},
          errCheck: {{ 'size_finder.error_check' | t | json }}
        }
      }
    };
  </script>
  <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

  {{ content_for_header }}
</head>

<body class="template-{{ template.name }}{% if template.suffix != blank %} template-{{ template.name }}--{{ template.suffix }}{% endif %}">
  <a class="skip-link" href="#MainContent">{{ 'general.skip_to_content' | t }}</a>

  {% sections 'header-group' %}

  <main id="MainContent" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {% render 'search-overlay' %}
  {% section 'cart-drawer' %}

  <div class="toast" id="Toast" role="status" hidden></div>
</body>
</html>
