{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>{{ 'gift_card.title' | t }} – {{ shop.name }}</title>
  {% render 'fonts' %}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <style>:root{--bg:{{ settings.color_background }};--ink:{{ settings.color_text }};--accent:{{ settings.color_accent }};--ok:{{ settings.color_success }};--logo-w:{{ settings.logo_width }}px}</style>
  <script>window.theme = { strings: { copied: {{ 'gift_card.copied' | t | json }} } };</script>
  <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  {{ content_for_header }}
</head>
<body>
  <main class="wrap page-wrap center gift">
    <div class="logo-link">{% render 'logo' %}</div>
    <h1 class="ctitle">{{ 'gift_card.title' | t }}</h1>
    <p class="gift-value">{{ gift_card.initial_value | money_with_currency }}</p>
    {%- if gift_card.enabled == false or gift_card.expired -%}
      <p>{{ 'gift_card.invalid' | t }}</p>
    {%- endif -%}
    <p class="gift-code">{{ gift_card.code | format_code }}</p>
    <button type="button" class="btn-outline gift-copy" data-copy="{{ gift_card.code }}">{{ 'gift_card.copy' | t }}</button>
    {%- if gift_card.balance != gift_card.initial_value -%}
      {%- assign balance = gift_card.balance | money_with_currency -%}
      <p>{{ 'gift_card.balance' | t: amount: balance }}</p>
    {%- endif -%}
    {%- if gift_card.expires_on -%}
      {%- assign expiry = gift_card.expires_on | date: format: 'short' -%}
      <p class="vat">{{ 'gift_card.valid_until' | t: date: expiry }}</p>
    {%- endif -%}
    <a class="atc inline" href="{{ shop.url }}">{{ 'gift_card.redeem' | t }}</a>
    <div class="toast" id="Toast" role="status" hidden></div>
  </main>
</body>
</html>
