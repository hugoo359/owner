{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ 'gift_card.title' | t }} – {{ shop.name }}</title>
  {% render 'theme-styles' %}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="scheme-dark">
  <main class="page section-pad">
    <div class="wrap page-inner page-inner--narrow center">
      <div class="logo-link">{% render 'logo', size: 'lg' %}</div>
      <h1 class="h1 page-title">{{ 'gift_card.title' | t }}</h1>
      <p class="h2">{{ gift_card.initial_value | money_with_currency }}</p>
      {%- if gift_card.enabled == false or gift_card.expired -%}
        <p>{{ 'gift_card.invalid' | t }}</p>
      {%- endif -%}
      <p class="gift-code">{{ gift_card.code | format_code }}</p>
      {%- if gift_card.balance != gift_card.initial_value -%}
        {%- assign balance = gift_card.balance | money_with_currency -%}
        <p>{{ 'gift_card.remaining' | t: balance: balance }}</p>
      {%- endif -%}
      {%- if gift_card.expires_on -%}
        {%- assign until = gift_card.expires_on | date: '%b %d, %Y' -%}
        <p class="eyebrow">{{ 'gift_card.valid_until' | t: date: until }}</p>
      {%- endif -%}
      <div class="btn-row btn-row--center"><a class="btn btn--solid" href="{{ shop.url }}">{{ 'gift_card.redeem' | t }}</a></div>
    </div>
  </main>
</body>
</html>
