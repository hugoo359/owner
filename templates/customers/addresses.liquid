<script src="{{ 'shopify_common.js' | shopify_asset_url }}" defer="defer"></script>
<div class="wrap form-page">
  <nav class="crumbs"><a href="{{ routes.account_url }}">{{ 'customer.account.title' | t }}</a></nav>
  <h1 class="ctitle">{{ 'customer.addresses.title' | t }}</h1>

  {%- paginate customer.addresses by 10 -%}
    {%- for address in customer.addresses -%}
      <div class="address-card">
        {{ address | format_address }}
        {%- if address == customer.default_address -%}<p class="vat">{{ 'customer.addresses.default' | t }}</p>{%- endif -%}
        <div class="address-actions">
          <button type="button" class="link-u" data-addr-edit="{{ address.id }}" aria-expanded="false" aria-controls="EditAddress-{{ address.id }}">{{ 'customer.addresses.edit' | t }}</button>
          <form method="post" action="{{ routes.account_addresses_url }}/{{ address.id }}" data-addr-delete data-confirm="{{ 'customer.addresses.delete_confirm' | t | escape }}">
            <input type="hidden" name="_method" value="delete">
            <button type="submit" class="link-u">{{ 'customer.addresses.delete' | t }}</button>
          </form>
        </div>
        <div id="EditAddress-{{ address.id }}" class="address-edit" hidden>
          {%- form 'customer_address', address, class: 'form-box' -%}
            {% render 'address-fields', form: form, id: address.id %}
            <button type="submit" class="atc">{{ 'customer.addresses.save' | t }}</button>
            <button type="button" class="btn-outline" data-addr-edit="{{ address.id }}">{{ 'customer.addresses.cancel' | t }}</button>
          {%- endform -%}
        </div>
      </div>
    {%- endfor -%}
    {%- if paginate.pages > 1 -%}{% render 'pagination', paginate: paginate %}{%- endif -%}
  {%- endpaginate -%}

  <h2 class="sub-title">{{ 'customer.addresses.new' | t }}</h2>
  {%- form 'customer_address', customer.new_address, class: 'form-box' -%}
    {% render 'address-fields', form: form, id: 'new' %}
    <button type="submit" class="atc">{{ 'customer.addresses.save' | t }}</button>
  {%- endform -%}
</div>
