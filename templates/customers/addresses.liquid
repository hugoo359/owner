<div class="wrap form-page">
  <nav class="crumbs"><a href="{{ routes.account_url }}">Mein Konto</a></nav>
  <h1 class="ctitle">Adressen</h1>
  {%- paginate customer.addresses by 10 -%}
    {%- for address in customer.addresses -%}
      <div class="address-card">
        {{ address | format_address }}
        {%- if address == customer.default_address -%}<p class="vat">Standardadresse</p>{%- endif -%}
        <form method="post" action="/account/addresses/{{ address.id }}">
          <input type="hidden" name="_method" value="delete">
          <button type="submit" class="link-u">Löschen</button>
        </form>
      </div>
    {%- endfor -%}
  {%- endpaginate -%}
  <h2 class="sub-title">Neue Adresse</h2>
  {%- form 'customer_address', customer.new_address, class: 'form-box' -%}
    <label for="AddrFirst">Vorname</label><input type="text" id="AddrFirst" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name">
    <label for="AddrLast">Nachname</label><input type="text" id="AddrLast" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name">
    <label for="AddrStreet">Straße und Hausnummer</label><input type="text" id="AddrStreet" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1">
    <label for="AddrZip">PLZ</label><input type="text" id="AddrZip" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code">
    <label for="AddrCity">Ort</label><input type="text" id="AddrCity" name="address[city]" value="{{ form.city }}" autocomplete="address-level2">
    <label for="AddrCountry">Land</label>
    <select id="AddrCountry" name="address[country]" data-default="{{ form.country }}">{{ all_country_option_tags }}</select>
    <label class="check"><input type="checkbox" name="address[default]" value="1"> Als Standardadresse festlegen</label>
    <button type="submit" class="atc">ADRESSE SPEICHERN</button>
  {%- endform -%}
</div>
