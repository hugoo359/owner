<div class="wrap form-page">
  <nav class="crumbs"><a href="{{ routes.account_url }}">My account</a></nav>
  <h1 class="ctitle">Addresses</h1>
  {%- paginate customer.addresses by 10 -%}
    {%- for address in customer.addresses -%}
      <div class="address-card">
        {{ address | format_address }}
        {%- if address == customer.default_address -%}<p class="vat">Default address</p>{%- endif -%}
        <form method="post" action="{{ routes.account_addresses_url }}/{{ address.id }}">
          <input type="hidden" name="_method" value="delete">
          <button type="submit" class="link-u">Delete</button>
        </form>
      </div>
    {%- endfor -%}
  {%- endpaginate -%}
  <h2 class="sub-title">New address</h2>
  {%- form 'customer_address', customer.new_address, class: 'form-box' -%}
    <label for="AddrFirst">First name</label><input type="text" id="AddrFirst" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name">
    <label for="AddrLast">Last name</label><input type="text" id="AddrLast" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name">
    <label for="AddrStreet">Street address</label><input type="text" id="AddrStreet" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1">
    <label for="AddrZip">ZIP / Postal code</label><input type="text" id="AddrZip" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code">
    <label for="AddrCity">City</label><input type="text" id="AddrCity" name="address[city]" value="{{ form.city }}" autocomplete="address-level2">
    <label for="AddrCountry">Country</label>
    <select id="AddrCountry" name="address[country]" data-default="{{ form.country }}">{{ all_country_option_tags }}</select>
    <label class="check"><input type="checkbox" name="address[default]" value="1"> Set as default address</label>
    <button type="submit" class="atc">SAVE ADDRESS</button>
  {%- endform -%}
</div>
