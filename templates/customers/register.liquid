<div class="wrap form-page">
  <h1 class="ctitle">Konto erstellen</h1>
  {%- form 'create_customer', class: 'form-box' -%}
    {{ form.errors | default_errors }}
    <label for="RegFirst">Vorname</label><input type="text" name="customer[first_name]" id="RegFirst" autocomplete="given-name">
    <label for="RegLast">Nachname</label><input type="text" name="customer[last_name]" id="RegLast" autocomplete="family-name">
    <label for="RegEmail">E-Mail</label><input type="email" name="customer[email]" id="RegEmail" autocomplete="email" required>
    <label for="RegPassword">Passwort</label><input type="password" name="customer[password]" id="RegPassword" autocomplete="new-password" required>
    <button type="submit" class="atc">KONTO ERSTELLEN</button>
  {%- endform -%}
</div>
