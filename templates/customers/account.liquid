<div class="wrap form-page">
  <h1 class="ctitle">Mein Konto</h1>
  <p>Hallo {{ customer.first_name | default: customer.email }} · <a class="link-u" href="{{ routes.account_logout_url }}">Abmelden</a></p>
  <h2 class="sub-title">Bestellungen</h2>
  {%- paginate customer.orders by 20 -%}
    {%- if customer.orders.size > 0 -%}
      <table class="table">
        <thead><tr><th>Bestellung</th><th>Datum</th><th>Status</th><th>Summe</th></tr></thead>
        <tbody>
          {%- for order in customer.orders -%}
            <tr><td><a class="link-u" href="{{ order.customer_url }}">{{ order.name }}</a></td><td>{{ order.created_at | date: '%d.%m.%Y' }}</td><td>{{ order.fulfillment_status_label }}</td><td>{{ order.total_price | money_with_currency }}</td></tr>
          {%- endfor -%}
        </tbody>
      </table>
    {%- else -%}
      <p>Du hast noch keine Bestellungen.</p>
    {%- endif -%}
  {%- endpaginate -%}
  <h2 class="sub-title">Adresse</h2>
  {%- if customer.default_address -%}{{ customer.default_address | format_address }}{%- endif -%}
  <a class="link-u" href="{{ routes.account_addresses_url }}">Adressen verwalten ({{ customer.addresses_count }})</a>
</div>
