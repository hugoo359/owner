<div class="wrap form-page">
  <h1 class="ctitle">{{ 'customer.account.title' | t }}</h1>
  {%- assign hello_name = customer.first_name | default: customer.email -%}
  <p>{{ 'customer.account.hello' | t: name: hello_name }} · <a class="link-u" href="{{ routes.account_logout_url }}">{{ 'customer.account.log_out' | t }}</a></p>
  <h2 class="sub-title">{{ 'customer.account.orders' | t }}</h2>
  {%- paginate customer.orders by 20 -%}
    {%- if customer.orders.size > 0 -%}
      <table class="table">
        <thead><tr><th>{{ 'customer.account.order' | t }}</th><th>{{ 'customer.account.date' | t }}</th><th>{{ 'customer.account.status' | t }}</th><th>{{ 'customer.account.total' | t }}</th></tr></thead>
        <tbody>
          {%- for order in customer.orders -%}
            <tr><td><a class="link-u" href="{{ order.customer_url }}">{{ order.name }}</a></td><td>{{ order.created_at | date: format: 'short' }}</td><td>{{ order.fulfillment_status_label }}</td><td>{{ order.total_price | money_with_currency }}</td></tr>
          {%- endfor -%}
        </tbody>
      </table>
      {%- if paginate.pages > 1 -%}{% render 'pagination', paginate: paginate %}{%- endif -%}
    {%- else -%}
      <p>{{ 'customer.account.no_orders' | t }}</p>
    {%- endif -%}
  {%- endpaginate -%}
  <h2 class="sub-title">{{ 'customer.account.address' | t }}</h2>
  {%- if customer.default_address -%}{{ customer.default_address | format_address }}{%- endif -%}
  <a class="link-u" href="{{ routes.account_addresses_url }}">{{ 'customer.account.manage_addresses' | t: count: customer.addresses_count }}</a>
</div>
