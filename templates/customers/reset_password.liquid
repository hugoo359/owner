<div class="wrap form-page">
  <h1 class="ctitle">New password</h1>
  {%- form 'reset_customer_password', class: 'form-box' -%}
    {{ form.errors | default_errors }}
    <label for="ResetPw">Password</label><input type="password" name="customer[password]" id="ResetPw" autocomplete="new-password" required>
    <label for="ResetPw2">Confirm password</label><input type="password" name="customer[password_confirmation]" id="ResetPw2" autocomplete="new-password" required>
    <button type="submit" class="atc">SAVE PASSWORD</button>
  {%- endform -%}
</div>
