<div class="wrap form-page">
  <h1 class="ctitle">{{ 'customer.reset.title' | t }}</h1>
  {%- form 'reset_customer_password', class: 'form-box' -%}
    {{ form.errors | default_errors }}
    <label for="ResetPw">{{ 'customer.password' | t }}</label><input type="password" name="customer[password]" id="ResetPw" autocomplete="new-password" required>
    <label for="ResetPw2">{{ 'customer.password_confirm' | t }}</label><input type="password" name="customer[password_confirmation]" id="ResetPw2" autocomplete="new-password" required>
    <button type="submit" class="atc">{{ 'customer.reset.submit' | t }}</button>
  {%- endform -%}
</div>
