<div class="wrap form-page">
  <h1 class="ctitle">Konto aktivieren</h1>
  {%- form 'activate_customer_password', class: 'form-box' -%}
    {{ form.errors | default_errors }}
    <label for="ActPw">Passwort</label><input type="password" name="customer[password]" id="ActPw" autocomplete="new-password" required>
    <label for="ActPw2">Passwort bestätigen</label><input type="password" name="customer[password_confirmation]" id="ActPw2" autocomplete="new-password" required>
    <button type="submit" class="atc">AKTIVIEREN</button>
    <button type="submit" name="decline" class="btn-outline">ABLEHNEN</button>
  {%- endform -%}
</div>
