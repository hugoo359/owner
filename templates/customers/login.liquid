<div class="wrap form-page">
  <h1 class="ctitle">Log in</h1>
  {%- form 'customer_login', class: 'form-box' -%}
    {{ form.errors | default_errors }}
    <label for="LoginEmail">Email</label>
    <input type="email" name="customer[email]" id="LoginEmail" autocomplete="email" required>
    {%- if form.password_needed -%}
      <label for="LoginPassword">Password</label>
      <input type="password" name="customer[password]" id="LoginPassword" autocomplete="current-password" required>
      <a class="link-u" href="#recover" data-recover-toggle>Forgot your password?</a>
    {%- endif -%}
    <button type="submit" class="atc">LOG IN</button>
    <a class="link-u" href="{{ routes.account_register_url }}">Create account</a>
  {%- endform -%}
  <div id="recover" class="form-box recover">
    <h2 class="sub-title">Reset your password</h2>
    {%- form 'recover_customer_password' -%}
      {{ form.errors | default_errors }}
      {%- if form.posted_successfully? -%}<p>We've sent you an email with a link to reset your password.</p>{%- endif -%}
      <label for="RecoverEmail">Email</label>
      <input type="email" name="email" id="RecoverEmail" autocomplete="email" required>
      <button type="submit" class="btn-outline">SEND LINK</button>
    {%- endform -%}
  </div>
  {%- if shop.checkout.guest_login -%}
    {%- form 'guest_login' -%}<button type="submit" class="btn-outline">CONTINUE AS GUEST</button>{%- endform -%}
  {%- endif -%}
</div>
