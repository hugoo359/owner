<div class="wrap form-page">
  <h1 class="ctitle">Anmelden</h1>
  {%- form 'customer_login', class: 'form-box' -%}
    {{ form.errors | default_errors }}
    <label for="LoginEmail">E-Mail</label>
    <input type="email" name="customer[email]" id="LoginEmail" autocomplete="email" required>
    {%- if form.password_needed -%}
      <label for="LoginPassword">Passwort</label>
      <input type="password" name="customer[password]" id="LoginPassword" autocomplete="current-password" required>
      <a class="link-u" href="#recover" data-recover-toggle>Passwort vergessen?</a>
    {%- endif -%}
    <button type="submit" class="atc">ANMELDEN</button>
    <a class="link-u" href="{{ routes.account_register_url }}">Konto erstellen</a>
  {%- endform -%}
  <div id="recover" class="form-box recover">
    <h2 class="sub-title">Passwort zurücksetzen</h2>
    {%- form 'recover_customer_password' -%}
      {{ form.errors | default_errors }}
      {%- if form.posted_successfully? -%}<p>Wir haben dir eine E-Mail mit einem Link zum Zurücksetzen geschickt.</p>{%- endif -%}
      <label for="RecoverEmail">E-Mail</label>
      <input type="email" name="email" id="RecoverEmail" autocomplete="email" required>
      <button type="submit" class="btn-outline">LINK SENDEN</button>
    {%- endform -%}
  </div>
  {%- if shop.checkout.guest_login -%}
    {%- form 'guest_login' -%}<button type="submit" class="btn-outline">ALS GAST FORTFAHREN</button>{%- endform -%}
  {%- endif -%}
</div>
