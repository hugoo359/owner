{%- liquid
  assign threshold = settings.free_shipping_threshold | times: 100
  assign remaining = threshold | minus: cart.total_price
  assign progress = 0
  assign remaining_money = remaining | money_with_currency
  if threshold > 0
    assign progress = cart.total_price | times: 100 | divided_by: threshold | at_most: 100
  endif
-%}
<div id="cart" class="layer" hidden>
  <div class="backdrop" data-close="cart"></div>
  <aside class="drawer" aria-label="{{ 'cart.page_title' | t }}" role="dialog">
    <div class="d-head">
      <h2>{{ 'cart.title' | t }}</h2>
      <button type="button" data-close="cart" aria-label="{{ 'cart.close' | t }}">{% render 'icon', icon: 'close-thin' %}</button>
    </div>
    <div id="CartDrawerInner" class="drawer-inner" data-count="{{ cart.item_count }}">
      {%- if cart.item_count == 0 -%}
        <div class="d-scroll">
          <div class="cart-empty">
            {{ 'cart.empty' | t }}<br>
            <a href="{{ routes.all_products_collection_url }}">{{ 'general.shop_now' | t }}</a>
          </div>
        </div>
      {%- else -%}
        <div class="d-scroll">
          {%- if threshold > 0 -%}
            <div class="ship">
              {%- if remaining > 0 -%}
                {{ 'cart.free_shipping_remaining_html' | t: amount: remaining_money }}
              {%- else -%}
                <b>{{ 'cart.free_shipping_unlocked' | t }}</b>
              {%- endif -%}
              <div class="bar"><i data-bar style="width: {{ progress }}%"></i></div>
            </div>
          {%- endif -%}
          {%- if settings.cart_note_title != blank or settings.cart_note_text != blank -%}
            <div class="good">{% render 'icon', icon: 'check' %}<b>{{ settings.cart_note_title }}</b> {{ settings.cart_note_text }}</div>
          {%- endif -%}

          {%- for item in cart.items -%}
            <div class="line" data-key="{{ item.key }}">
              <a href="{{ item.url }}" class="media">
                {%- if item.image -%}{{ item.image | image_url: width: 240 | image_tag: alt: item.product.title, loading: 'lazy' }}{%- endif -%}
              </a>
              <div>
                <h3><a href="{{ item.url }}">{{ item.product.title }}</a></h3>
                <div class="pr">{{ item.final_price | money_with_currency }}</div>
                {%- unless item.product.has_only_default_variant -%}
                  <div class="size">{{ item.variant.title | downcase }}</div>
                {%- endunless -%}
                <div class="qty-row">
                  <div class="qty">
                    <button type="button" data-line="{{ forloop.index }}" data-qty="{{ item.quantity | minus: 1 }}" aria-label="{{ 'cart.decrease' | t }}">{% render 'icon', icon: 'qty-minus' %}</button>
                    <span data-qty-num>{{ item.quantity }}</span>
                    <button type="button" data-line="{{ forloop.index }}" data-qty="{{ item.quantity | plus: 1 }}" aria-label="{{ 'cart.increase' | t }}">{% render 'icon', icon: 'qty-plus' %}</button>
                  </div>
                  <button type="button" class="link-u" data-line="{{ forloop.index }}" data-qty="0">{{ 'cart.remove' | t }}</button>
                </div>
              </div>
            </div>
          {%- endfor -%}

          {%- if settings.cart_upsell_collection != blank -%}
            {%- assign in_cart = cart.items | map: 'product_id' | join: ',' | prepend: ',' | append: ',' -%}
            {%- assign n = 0 -%}
            {%- capture ups -%}
              {%- for p in settings.cart_upsell_collection.products limit: 16 -%}
                {%- assign key = p.id | prepend: ',' | append: ',' -%}
                {%- if in_cart contains key or p.available == false -%}{%- continue -%}{%- endif -%}
                {%- if n >= 2 -%}{%- break -%}{%- endif -%}
                {%- assign n = n | plus: 1 -%}
                <div class="line{% if n > 1 %} is-hidden{% endif %}" data-ups="{{ n }}">
                  <a href="{{ p.url }}" class="media">
                    {%- if p.featured_media -%}{{ p.featured_media | image_url: width: 240 | image_tag: alt: p.title, loading: 'lazy' }}{%- endif -%}
                  </a>
                  <div>
                    <h3><a href="{{ p.url }}">{{ p.title }}</a></h3>
                    <div class="pr">{{ p.price | money_with_currency }}</div>
                    <button type="button" class="link-u ups-add" data-add-variant="{{ p.first_available_variant.id }}">{{ 'cart.add' | t }}</button>
                  </div>
                </div>
              {%- endfor -%}
            {%- endcapture -%}
            {%- if n > 0 -%}
              <div class="upsell">
                <div class="upsell-head">{{ 'cart.pairs_well' | t }}
                  {%- if n > 1 -%}
                    <div class="udots"><button type="button" class="on" data-ups-dot="1" aria-label="{{ 'cart.suggestion' | t: number: 1 }}"></button><button type="button" data-ups-dot="2" aria-label="{{ 'cart.suggestion' | t: number: 2 }}"></button></div>
                  {%- endif -%}
                </div>
                {{ ups }}
              </div>
            {%- endif -%}
          {%- endif -%}
        </div>

        <div class="d-foot">
          <div class="sumrow b"><span>{{ 'cart.subtotal' | t }}</span><span>{{ cart.total_price | money_with_currency }}</span></div>
          <div class="sumrow">
            <span>{{ 'cart.shipping' | t }}</span>
            <span>
              {%- if threshold > 0 and remaining <= 0 -%}{{ 'cart.shipping_free' | t }}
              {%- elsif settings.shipping_label != blank -%}{{ settings.shipping_label }}
              {%- else -%}{{ 'cart.shipping_at_checkout' | t }}{%- endif -%}
            </span>
          </div>
          <form action="{{ routes.cart_url }}" method="post">
            <button type="submit" name="checkout" class="checkout">{{ 'cart.checkout' | t }}</button>
          </form>
        </div>
      {%- endif -%}
    </div>
  </aside>
</div>

{% schema %}
{
  "name": "Warenkorb-Seitenleiste",
  "settings": [
    { "type": "paragraph", "content": "Einstellungen findest du unter Theme-Einstellungen > Warenkorb." }
  ]
}
{% endschema %}
