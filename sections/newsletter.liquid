{%- liquid
  assign s = section.settings
  assign form_id = 'Newsletter-' | append: section.id
-%}
<section class="nl scheme-{{ s.color_scheme }} section-pad">
  <div class="wrap nl-inner">
    {%- if s.eyebrow != blank -%}<p class="eyebrow" data-reveal>{{ s.eyebrow }}</p>{%- endif -%}
    {%- if s.heading != blank -%}<h2 class="h2" data-split>{{ s.heading }}</h2>{%- endif -%}
    {%- if s.text != blank -%}<div class="rte" data-reveal>{{ s.text }}</div>{%- endif -%}
    <div data-reveal>{% render 'newsletter-form', form_id: form_id, tags: s.tags %}</div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "tag": "div",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Farbschema", "default": "sand", "options": [
      { "value": "dark", "label": "Nacht" }, { "value": "light", "label": "Pergament" }, { "value": "sand", "label": "Sand" }
    ] },
    { "type": "text", "id": "eyebrow", "label": "Kleine Zeile", "default": "Newsletter" },
    { "type": "inline_richtext", "id": "heading", "label": "Überschrift", "default": "Letters from the house" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>New releases, early access and the stories behind each figure.</p>" },
    { "type": "text", "id": "tags", "label": "Kunden-Tags", "default": "newsletter" }
  ],
  "presets": [ { "name": "Newsletter" } ]
}
{% endschema %}
