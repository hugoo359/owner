<footer class="ftr scheme-{{ section.settings.color_scheme }}">
  <div class="ftr-top wrap">
    <div class="ftr-brand" data-reveal>
      <a href="{{ routes.root_url }}" class="logo-link" aria-label="{{ shop.name }}">{% render 'logo', size: 'lg' %}</a>
      {%- if section.settings.tagline != blank -%}<div class="ftr-tagline rte">{{ section.settings.tagline }}</div>{%- endif -%}
      {% render 'social-links' %}
    </div>

    <div class="ftr-cols">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            <div class="ftr-col" data-reveal {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}<h2 class="eyebrow">{{ block.settings.heading }}</h2>{%- endif -%}
              <ul class="ftr-list">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
                {%- if block.settings.show_policies -%}
                  {%- for policy in shop.policies -%}
                    <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
                  {%- endfor -%}
                {%- endif -%}
              </ul>
            </div>
          {%- when 'text' -%}
            <div class="ftr-col" data-reveal {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}<h2 class="eyebrow">{{ block.settings.heading }}</h2>{%- endif -%}
              <div class="rte ftr-text">{{ block.settings.text }}</div>
              {%- if block.settings.show_email and shop.email != blank -%}
                <p class="ftr-text"><a class="link-line" href="mailto:{{ shop.email }}">{{ shop.email }}</a></p>
              {%- endif -%}
            </div>
          {%- when 'newsletter' -%}
            <div class="ftr-col ftr-col--wide" data-reveal {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}<h2 class="eyebrow">{{ block.settings.heading }}</h2>{%- endif -%}
              {%- if block.settings.text != blank -%}<div class="rte ftr-text">{{ block.settings.text }}</div>{%- endif -%}
              {% render 'newsletter-form', form_id: 'FooterNewsletter', tags: 'newsletter, footer' %}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  {%- if section.settings.big_wordmark -%}
    <div class="ftr-mark" aria-hidden="true"><span>{{ shop.name }}</span></div>
  {%- endif -%}

  <div class="ftr-bottom wrap">
    {%- assign year = 'now' | date: '%Y' -%}
    <p>{{ 'footer.copyright' | t: year: year, shop: shop.name }}{% if section.settings.copyright != blank %} · {{ section.settings.copyright }}{% endif %}</p>
    <div class="ftr-bottom-right">
      {%- if section.settings.show_payments -%}
        <div class="pays" aria-label="{{ 'footer.payment_methods' | t }}">{% render 'payment-icons' %}</div>
      {%- endif -%}
      <button type="button" class="link-line ftr-cookie" data-cookie-settings>{{ 'footer.cookie_settings' | t }}</button>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Farbschema", "default": "dark", "options": [
      { "value": "dark", "label": "Nacht" },
      { "value": "light", "label": "Pergament" },
      { "value": "sand", "label": "Sand" }
    ] },
    { "type": "richtext", "id": "tagline", "label": "Kurzer Markentext", "default": "<p>Extraits de parfum shaped by the figures who ruled their age.</p>" },
    { "type": "checkbox", "id": "big_wordmark", "label": "Großer Schriftzug am Seitenende", "default": true },
    { "type": "checkbox", "id": "show_payments", "label": "Zahlungsarten anzeigen", "default": true },
    { "type": "text", "id": "copyright", "label": "Zusatz neben dem Copyright", "default": "All rights reserved." }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menü-Spalte",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "heading", "label": "Überschrift", "default": "Maison" },
        { "type": "link_list", "id": "menu", "label": "Menü" },
        { "type": "checkbox", "id": "show_policies", "label": "Rechtliche Seiten automatisch anzeigen", "default": false, "info": "Zeigt die unter Einstellungen > Richtlinien hinterlegten Seiten." }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "heading", "label": "Überschrift", "default": "Contact" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Questions about an order, press or wholesale? Write to us.</p>" },
        { "type": "checkbox", "id": "show_email", "label": "Shop-E-Mail anzeigen", "default": true, "info": "Nutzt die E-Mail unter Einstellungen > Allgemein." }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Überschrift", "default": "Newsletter" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>First access to new releases. No noise.</p>" }
      ]
    }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
