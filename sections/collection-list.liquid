<section class="home-sec cl" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px">
  {%- if section.settings.heading != blank -%}
    <div class="section-head"><h2 class="sh-title split-title" data-split>{{ section.settings.heading }}</h2></div>
  {%- endif -%}
  <div class="cl-grid" style="--cols: {{ section.settings.columns }}">
    {%- for block in section.blocks -%}
      {%- assign c = block.settings.collection -%}
      {%- assign img = block.settings.image | default: c.featured_image -%}
      <a class="cl-card" href="{{ c.url | default: routes.collections_url }}" data-reveal {{ block.shopify_attributes }}>
        <div class="cl-media">
          {%- if img != blank -%}
            {{ img | image_url: width: 1000 | image_tag: loading: 'lazy', sizes: '(min-width: 1100px) 25vw, 50vw', widths: '400, 600, 800, 1000', alt: img.alt | default: c.title }}
          {%- else -%}
            {{ 'collection-apparel-3' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        <span class="cl-label">{{ block.settings.title | default: c.title | default: 'Kollektion' }}</span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Kollektionsliste",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "SHOP NACH KATEGORIE" },
    { "type": "range", "id": "columns", "label": "Spalten (Desktop)", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "range", "id": "padding_top", "label": "Abstand oben", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Abstand unten", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 24 }
  ],
  "blocks": [
    { "type": "collection", "name": "Kollektion", "settings": [
      { "type": "collection", "id": "collection", "label": "Kollektion" },
      { "type": "image_picker", "id": "image", "label": "Eigenes Bild", "info": "Leer = Bild der Kollektion" },
      { "type": "text", "id": "title", "label": "Eigener Titel", "info": "Leer = Name der Kollektion" }
    ] }
  ],
  "max_blocks": 12,
  "presets": [ { "name": "Kollektionsliste", "blocks": [ { "type": "collection" }, { "type": "collection" }, { "type": "collection" }, { "type": "collection" } ] } ]
}
{% endschema %}
