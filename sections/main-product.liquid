{%- liquid
  assign current = product.selected_or_first_available_variant
  assign featured = current.featured_media | default: product.featured_media
-%}
<section class="pdp" data-product data-section="{{ section.id }}">
  <div class="thumbs" data-thumbs>
    {%- for media in product.media -%}
      <button type="button" class="{% if media.id == featured.id %}on{% endif %}" data-media="{{ media.id }}" aria-label="Bild {{ forloop.index }}">
        {{ media.preview_image | image_url: width: 140 | image_tag: alt: '', loading: 'lazy' }}
      </button>
    {%- endfor -%}
  </div>

  <div class="pdp-stage">
  <div class="pdp-main" data-gallery>
    {%- for media in product.media -%}
      {%- liquid
        if media.id == featured.id
          assign ld = 'eager'
        else
          assign ld = 'lazy'
        endif
      -%}
      <div class="media{% unless media.id == featured.id %} is-off{% endunless %}" data-media-main="{{ media.id }}" data-zoom>
        {{ media.preview_image | image_url: width: 1800 | image_tag: sizes: '(min-width: 1100px) 45vw, 100vw', widths: '600, 900, 1200, 1500, 1800', loading: ld, alt: media.alt }}
      </div>
    {%- else -%}
      <div class="media">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
    {%- endfor -%}
  </div>
  {%- if product.media.size > 1 -%}
    <div class="pdp-dots" data-dots aria-hidden="true">
      {%- for media in product.media -%}
        <span class="{% if media.id == featured.id %}on{% endif %}" data-dot="{{ media.id }}"></span>
      {%- endfor -%}
    </div>
    <div class="pdp-count" data-count aria-hidden="true"><b data-count-now>{% for media in product.media %}{% if media.id == featured.id %}{{ forloop.index }}{% endif %}{% endfor %}</b> / {{ product.media.size }}</div>
  {%- endif -%}
  </div>

  <div class="pinfo">
    {%- if section.settings.show_social_proof -%}
      {%- liquid
        assign sp_names = section.settings.sp_names | split: ','
        assign sp_brand = section.settings.sp_brand | default: shop.name
      -%}
      <div class="sp" data-sp>
        <div class="sp-top">
          <div class="sp-avatars" aria-hidden="true">
            {%- for i in (1..3) -%}
              {%- assign akey = 'sp_avatar_' | append: i -%}
              {%- assign aimg = section.settings[akey] -%}
              {%- if aimg != blank -%}
                <span class="sp-av" style="--i: {{ forloop.index0 }}">{{ aimg | image_url: width: 96, height: 96, crop: 'center' | image_tag: alt: '', loading: 'eager', width: 48, height: 48 }}</span>
              {%- elsif i <= 2 and sp_names[forloop.index0] != blank -%}
                <span class="sp-av sp-av--txt" style="--i: {{ forloop.index0 }}">{{ sp_names[forloop.index0] | strip | slice: 0 | upcase }}</span>
              {%- endif -%}
            {%- endfor -%}
          </div>
          <p class="sp-text">
            <b>{{ section.settings.sp_names | strip }}</b>
            {%- if section.settings.sp_verified -%}
              <svg class="sp-badge" width="16" height="16" viewBox="0 0 24 24" aria-label="verifiziert" role="img"><path fill="currentColor" d="M12 1.5l2.6 1.9 3.2-.1 1 3 2.6 1.9-1 3.1 1 3-2.6 1.9-1 3.1-3.2-.1L12 22.5l-2.6-1.9-3.2.1-1-3.1-2.6-1.9 1-3-1-3.1 2.6-1.9 1-3 3.2.1z"/><path d="M7.8 12.3l2.8 2.7 5.6-5.8" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {%- endif %}
            und <b data-sp-count="{{ section.settings.sp_count }}">{{ section.settings.sp_count }}</b> {{ section.settings.sp_text }} <b>{{ sp_brand }}</b>
          </p>
        </div>
        <div class="sp-rating">
          {%- assign rpct = section.settings.sp_rating | times: 20 -%}
          <span class="sp-stars" style="--r: {{ rpct }}%" aria-label="{{ section.settings.sp_rating }} von 5 Sternen" role="img">
            <span class="sp-stars-base">{%- for i in (1..5) -%}<svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z"/></svg>{%- endfor -%}</span>
            <span class="sp-stars-fill">{%- for i in (1..5) -%}<svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z"/></svg>{%- endfor -%}</span>
          </span>
          {%- if section.settings.sp_rating_text != blank -%}<span class="sp-rtext">{{ section.settings.sp_rating_text }}</span>{%- endif -%}
        </div>
      </div>
    {%- endif -%}
    <h1 class="split-title" data-split>{{ product.title }}</h1>
    <div class="pprice">
      <span data-price>{{ current.price | money_with_currency }}</span>
      <s data-compare{% unless current.compare_at_price > current.price %} hidden{% endunless %}>{{ current.compare_at_price | money_with_currency }}</s>
    </div>
    {%- capture unit_out -%}{% render 'unit-price', variant: current %}{%- endcapture -%}
    <div class="vat">
      {%- if settings.tax_text != blank -%}<span>{{ settings.tax_text }}</span>{%- endif -%}
      <span class="unit-price" data-unit-price{% if unit_out == blank %} hidden{% endif %}>{{ section.settings.t_unit_price }} <span data-unit-price-value>{{ unit_out }}</span></span>
    </div>

    {%- liquid
      # Düfte einer Linie als eigene Produkte (wie die Farben bei 6pm): Metafeld custom.color_variants
      # (Liste von Produkten) auf jedem Produkt der Linie. Name aus custom.color_name,
      # Kreisfarbe aus custom.color_swatch (Farb-Metafeld) oder aus der Theme-Farbzuordnung.
      assign has_color_option = false
      for option in product.options
        assign on = option | downcase
        if on contains 'farbe' or on contains 'color' or on contains 'colour'
          assign has_color_option = true
        endif
      endfor
      assign siblings = product.metafields.custom.color_variants.value
      assign self_in_list = false
      for p in siblings
        if p.id == product.id
          assign self_in_list = true
        endif
      endfor
      assign self_name = product.metafields.custom.color_name.value | default: product.title
    -%}
    {%- if has_color_option == false and siblings.size > 0 -%}
      <div class="plabel">{{ section.settings.color_label | default: 'Duft' }}: <span data-sib-label data-sib-default="{{ self_name | escape }}">{{ self_name }}</span></div>
      <div class="pswatches psiblings" data-siblings>
        {%- unless self_in_list -%}
          {%- capture swatch_bg -%}{%- if product.metafields.custom.color_swatch != blank -%}{{ product.metafields.custom.color_swatch.value }}{%- else -%}{% render 'color-value', name: self_name %}{%- endif -%}{%- endcapture -%}
          <a href="{{ product.url }}" class="on" aria-current="true" title="{{ self_name | escape }}" aria-label="{{ self_name | escape }}" data-sib-name="{{ self_name | escape }}" style="background:#ccc;background:{{ swatch_bg | strip }}"></a>
        {%- endunless -%}
        {%- for p in siblings -%}
          {%- assign pname = p.metafields.custom.color_name.value | default: p.title -%}
          {%- capture swatch_bg -%}{%- if p.metafields.custom.color_swatch != blank -%}{{ p.metafields.custom.color_swatch.value }}{%- else -%}{% render 'color-value', name: pname %}{%- endif -%}{%- endcapture -%}
          <a href="{{ p.url }}" class="{% if p.id == product.id %}on{% endif %}{% unless p.available %} is-sold{% endunless %}"{% if p.id == product.id %} aria-current="true"{% endif %} title="{{ pname | escape }}" aria-label="{{ pname | escape }}" data-sib-name="{{ pname | escape }}" style="background:#ccc;background:{{ swatch_bg | strip }}"></a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- unless product.has_only_default_variant -%}
      {%- for option in product.options_with_values -%}
        {%- assign on = option.name | downcase -%}
        {%- if on contains 'farbe' or on contains 'color' or on contains 'colour' -%}
          <div class="plabel">{{ option.name }}: <span data-option-label="{{ forloop.index0 }}">{{ option.selected_value }}</span></div>
          <div class="pswatches" data-option="{{ forloop.index0 }}">
            {%- for value in option.values -%}
              {%- assign vname = value.name | default: value -%}
              {%- capture swatch_bg -%}{%- if value.swatch.color -%}{{ value.swatch.color }}{%- else -%}{% render 'color-value', name: vname %}{%- endif -%}{%- endcapture -%}
              <button type="button" class="{% if vname == option.selected_value %}on{% endif %}" data-value="{{ vname | escape }}" title="{{ vname | escape }}" aria-label="{{ vname | escape }}" style="background:#ccc;background:{{ swatch_bg | strip }}"></button>
            {%- endfor -%}
          </div>
        {%- else -%}
          {%- assign is_size = false -%}
          {%- if on contains 'größe' or on contains 'grösse' or on contains 'groesse' or on contains 'size' or on contains 'inhalt' or on contains 'füllmenge' or on contains 'volum' -%}{%- assign is_size = true -%}{%- endif -%}
          <div class="plabel up">
            <span>{{ option.name }}:</span>
            {%- if is_size and section.settings.show_size_guide -%}
              <button type="button" class="size-link" data-open="sizeguide" data-sg-link>
                <span class="size-link-ico">{% render 'icon', icon: 'bottle' %}</span>
                <span class="size-link-ok" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12"><circle cx="6" cy="6" r="6" fill="currentColor"/><path d="M3.4 6.2l1.7 1.7 3.5-3.6" fill="none" stroke="#fff" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                <span data-sg-link-text>{{ section.settings.t_size_link }}</span>
              </button>
            {%- endif -%}
          </div>
          <div class="psizes" data-option="{{ forloop.index0 }}"{% if is_size %} data-size-group{% endif %} data-pick="{% if option.values.size == 1 %}auto{% else %}user{% endif %}" style="--n: {{ option.values.size | at_most: 7 }}">
            {%- for value in option.values -%}
              {%- assign vname = value.name | default: value -%}
              <button type="button" data-value="{{ vname | escape }}">{{ vname }}</button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    {%- endunless -%}

    {%- if section.settings.show_scent_info -%}
      {%- capture fams -%}{% render 'scent-families', product: product %}{%- endcapture -%}
      {%- capture conc -%}{% render 'mf-text', mf: product.metafields.custom.concentration %}{%- endcapture -%}
      {%- liquid
        assign fam_text = fams | strip | split: '|' | uniq | join: ' · '
        assign conc = conc | strip
        if conc == blank
          assign conc = product.type
        endif
      -%}
      {%- if fam_text != blank or conc != blank -%}
        <div class="strip{% if fam_text == blank or conc == blank %} strip--one{% endif %}">
          {%- if fam_text != blank -%}<span>{% if section.settings.t_family != blank %}{{ section.settings.t_family }}: {% endif %}{{ fam_text }}</span>{%- endif -%}
          {%- if fam_text != blank and conc != blank -%}<span class="sep">|</span>{%- endif -%}
          {%- if conc != blank -%}<span>{{ conc }}</span>{%- endif -%}
        </div>
      {%- endif -%}
    {%- endif -%}

    <div class="avail{% unless current.available %} out{% endunless %}" data-avail>
      <i></i>
      <span data-avail-text>
        {%- if current.available -%}<b>{{ settings.in_stock_text }}</b> {{ settings.delivery_text }}{%- else -%}<b>{{ settings.sold_out_text }}</b>{%- endif -%}
      </span>
    </div>

    {%- form 'product', product, class: 'pform', novalidate: 'novalidate' -%}
      <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>
      <button type="submit" class="atc" data-atc{% unless current.available %} disabled{% endunless %}>
        <span class="atc-label" data-atc-label>{%- if current.available -%}In den Warenkorb{%- else -%}Ausverkauft{%- endif -%}</span>
        <span class="atc-done" aria-hidden="true">{% render 'icon', icon: 'check-line' %}Hinzugefügt</span>
      </button>
      <div class="atc-msg" data-atc-msg role="status"></div>
    {%- endform -%}

    {%- if section.settings.show_payments -%}
      <div class="ppays">{% render 'payment-icons' %}</div>
    {%- endif -%}
    {%- if section.settings.exchange_text != blank -%}
      <div class="exchange">{{ section.settings.exchange_text }}</div>
    {%- endif -%}
    {%- if section.settings.show_logo -%}
      <div class="plogo">{% render 'logo' %}</div>
    {%- endif -%}

    <div class="acc">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'accordion' -%}
            {%- liquid
              assign mf_html = ''
              if block.settings.metafield != blank
                assign mfo = product.metafields.custom[block.settings.metafield]
                if mfo != blank
                  capture mf_html
                    echo mfo | metafield_tag
                  endcapture
                endif
              endif
              assign has_body = false
              if block.settings.use_description and product.description != blank
                assign has_body = true
              endif
              if mf_html != blank or block.settings.content != blank or block.settings.page != blank
                assign has_body = true
              endif
            -%}
            {%- if has_body or request.design_mode -%}
              <details {{ block.shopify_attributes }}>
                <summary>{% render 'icon', icon: block.settings.icon %}<span>{{ block.settings.title }}</span>{% render 'icon', icon: 'plus' %}</summary>
                <div class="body rte">
                  {%- if block.settings.use_description -%}{{ product.description }}{%- endif -%}
                  {%- if mf_html != blank -%}{{ mf_html }}{%- else -%}{{ block.settings.content }}{%- endif -%}
                  {%- if block.settings.page != blank -%}{{ block.settings.page.content }}{%- endif -%}
                </div>
              </details>
            {%- endif -%}

          {%- when 'notes' -%}
            {% render 'scent-notes', product: product, block: block %}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  <script type="application/json" data-product-json>{{ product | json }}</script>
  <script type="application/json" data-unit-prices>
    {
      {%- for v in product.variants -%}
        {%- capture u -%}{% render 'unit-price', variant: v %}{%- endcapture -%}
        "{{ v.id }}": {{ u | strip | json }}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    }
  </script>
</section>

{%- if section.settings.show_size_guide -%}
  {% render 'size-guide', sprays_per_ml: section.settings.sprays_per_ml %}
{%- endif -%}

{% schema %}
{
  "name": "Produktseite",
  "settings": [
    { "type": "header", "content": "Kundenstimmen über dem Namen" },
    { "type": "checkbox", "id": "show_social_proof", "label": "Anzeigen", "default": true },
    { "type": "image_picker", "id": "sp_avatar_1", "label": "Profilbild 1" },
    { "type": "image_picker", "id": "sp_avatar_2", "label": "Profilbild 2" },
    { "type": "image_picker", "id": "sp_avatar_3", "label": "Profilbild 3 (optional)" },
    { "type": "text", "id": "sp_names", "label": "Namen", "default": "Lena, Max", "info": "Mit Komma trennen. Ohne Profilbild wird der Anfangsbuchstabe gezeigt." },
    { "type": "checkbox", "id": "sp_verified", "label": "Verifiziert-Haken", "default": true },
    { "type": "number", "id": "sp_count", "label": "Anzahl weiterer Kunden", "default": 2500, "info": "Nutze echte Zahlen aus deinen Bestellungen oder Bewertungen." },
    { "type": "text", "id": "sp_text", "label": "Text nach der Zahl", "default": "weitere lieben" },
    { "type": "text", "id": "sp_brand", "label": "Markenname", "info": "Leer = Shopname" },
    { "type": "range", "id": "sp_rating", "label": "Sterne", "min": 1, "max": 5, "step": 0.5, "default": 5 },
    { "type": "text", "id": "sp_rating_text", "label": "Text neben den Sternen", "default": "Über 2.500 zufriedene Kunden" },
    { "type": "header", "content": "Preis" },
    { "type": "text", "id": "t_unit_price", "label": "Text vor dem Grundpreis", "default": "Grundpreis:", "info": "Der Grundpreis (z. B. pro 100 ml) erscheint, wenn du ihn bei der Variante unter „Grundpreis anzeigen“ hinterlegst. In Deutschland ist er für Parfum Pflicht." },
    { "type": "header", "content": "Düfte einer Linie als eigene Produkte" },
    { "type": "paragraph", "content": "Wie die Farben bei 6pm: Jeder Duft einer Linie ist ein eigenes Produkt und erscheint als Farbkreis. Lege unter Einstellungen → Benutzerdefinierte Daten → Produkte diese Metafelder an: custom.color_variants (Produkt, Liste), custom.color_name (Einzeiliger Text, Name des Dufts), custom.color_swatch (Farbe des Kreises). Trage bei jedem Produkt der Linie alle Düfte ein." },
    { "type": "text", "id": "color_label", "label": "Beschriftung", "default": "Duft" },
    { "type": "header", "content": "Duft-Info unter den Größen" },
    { "type": "checkbox", "id": "show_scent_info", "label": "Anzeigen", "default": true, "info": "Zeigt die Duftfamilie (Metafeld custom.scent_family oder Tags wie „Duftfamilie: Holzig“) und die Konzentration (Metafeld custom.concentration, sonst Produkttyp)." },
    { "type": "text", "id": "t_family", "label": "Beschriftung Duftfamilie", "default": "Duftfamilie" },
    { "type": "header", "content": "Größenberater (ml)" },
    { "type": "checkbox", "id": "show_size_guide", "label": "„Welche Größe passt?“ anzeigen", "default": true, "info": "Rechnet aus, wie lange jede Flaschengröße reicht, und empfiehlt eine Größe. Die Größen-Option sollte ml-Werte enthalten, z. B. 30 ml, 50 ml, 100 ml." },
    { "type": "text", "id": "t_size_link", "label": "Link-Text", "default": "Welche Größe passt?" },
    { "type": "range", "id": "sprays_per_ml", "label": "Sprühstöße pro ml", "min": 6, "max": 16, "step": 1, "default": 10, "info": "Richtwert für die Berechnung. Üblich sind etwa 10 Sprühstöße pro ml." },
    { "type": "checkbox", "id": "show_payments", "label": "Zahlungsarten unter dem Button", "default": true },
    { "type": "text", "id": "exchange_text", "label": "Hinweis-Leiste", "default": "Versiegelt & originalverpackt: 14 Tage Rückgaberecht" },
    { "type": "checkbox", "id": "show_logo", "label": "Logo über den Akkordeons", "default": true }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Akkordeon",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "info", "options": [
          { "value": "info", "label": "Info" },
          { "value": "spray", "label": "Zerstäuber (Anwendung)" },
          { "value": "leaf", "label": "Blatt (Inhaltsstoffe)" },
          { "value": "notes", "label": "Duftpyramide" },
          { "value": "truck", "label": "Versand" },
          { "value": "none", "label": "Kein Icon" }
        ] },
        { "type": "text", "id": "title", "label": "Titel", "default": "Produktinformation" },
        { "type": "checkbox", "id": "use_description", "label": "Produktbeschreibung anzeigen", "default": false },
        { "type": "richtext", "id": "content", "label": "Inhalt" },
        { "type": "select", "id": "metafield", "label": "Inhalt pro Produkt aus Metafeld", "default": "", "options": [
          { "value": "", "label": "Kein Metafeld" },
          { "value": "ingredients", "label": "custom.ingredients (Inhaltsstoffe)" },
          { "value": "how_to_use", "label": "custom.how_to_use (Anwendung)" }
        ], "info": "Ist das Metafeld beim Produkt ausgefüllt, ersetzt es den Inhalt oben." },
        { "type": "page", "id": "page", "label": "Inhalt aus Seite" }
      ]
    },
    {
      "type": "notes",
      "name": "Duftnoten",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Zeigt die Duftpyramide aus den Produkt-Metafeldern custom.top_notes, custom.heart_notes, custom.base_notes (Text oder Liste) und optional ein Duftprofil aus custom.intensity, custom.longevity, custom.sillage (Ganzzahl 1–5). Ohne Metafelder bleibt der Block unsichtbar." },
        { "type": "text", "id": "title", "label": "Titel", "default": "Duftnoten" },
        { "type": "checkbox", "id": "open", "label": "Geöffnet anzeigen", "default": true },
        { "type": "text", "id": "t_top", "label": "Kopfnote", "default": "Kopfnote" },
        { "type": "text", "id": "t_heart", "label": "Herznote", "default": "Herznote" },
        { "type": "text", "id": "t_base", "label": "Basisnote", "default": "Basisnote" },
        { "type": "text", "id": "t_intensity", "label": "Intensität", "default": "Intensität" },
        { "type": "text", "id": "t_longevity", "label": "Haltbarkeit", "default": "Haltbarkeit" },
        { "type": "text", "id": "t_sillage", "label": "Sillage", "default": "Sillage" }
      ]
    }
  ]
}
{% endschema %}
