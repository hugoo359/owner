{%- liquid
  assign s = section.settings
  assign current = product.selected_or_first_available_variant
  assign featured = current.featured_media | default: product.featured_media
  assign form_id = 'ProductForm-' | append: section.id
  capture status
    render 'product-status', product: product, variant: current
  endcapture
  assign status = status | strip
  assign soon_tag = settings.coming_soon_tag | strip | downcase
  assign is_soon = false
  for tag in product.tags
    assign t = tag | downcase
    if soon_tag != blank and t == soon_tag
      assign is_soon = true
    endif
  endfor
-%}
<section class="pdp scheme-{{ s.color_scheme }}" data-product data-section="{{ section.id }}" data-soon="{{ is_soon }}">
  <div class="pdp-grid wrap">
    <div class="pdp-gallery">
      {% render 'product-gallery', product: product, featured: featured, art: s.fallback_art, section_id: section.id %}
    </div>

    <div class="pdp-info">
      <div class="pdp-sticky">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'eyebrow' -%}
              {%- assign eb = block.settings.text | default: product.metafields.custom.era.value -%}
              {%- if eb != blank -%}<p class="eyebrow pdp-eyebrow" {{ block.shopify_attributes }}>{{ eb }}</p>{%- endif -%}

            {%- when 'title' -%}
              <h1 class="display pdp-title" data-split {{ block.shopify_attributes }}>{{ product.title }}</h1>

            {%- when 'subtitle' -%}
              {%- assign sub = block.settings.text | default: product.metafields.custom.subtitle.value | default: product.type -%}
              {%- if sub != blank -%}<p class="pdp-sub" {{ block.shopify_attributes }}>{{ sub }}</p>{%- endif -%}

            {%- when 'price' -%}
              <div class="pdp-price" {{ block.shopify_attributes }}>
                {% render 'price', product: product, variant: current %}
                {%- capture policy_link -%}{%- if shop.shipping_policy.body != blank -%}<a class="link-line" href="{{ shop.shipping_policy.url }}">{{ 'product.shipping_at_checkout' | t }}</a>{%- else -%}{{ 'product.shipping_at_checkout' | t }}{%- endif -%}{%- endcapture -%}
                <p class="pdp-tax">{% if shop.taxes_included %}{{ 'product.tax_included' | t }} {% endif %}{{ policy_link }}</p>
              </div>

            {%- when 'variant_picker' -%}
              {%- unless product.has_only_default_variant -%}
                <div class="pdp-options" data-options {{ block.shopify_attributes }}>
                  {%- for option in product.options_with_values -%}
                    {%- if option.values.size == 1 and block.settings.hide_single -%}{%- continue -%}{%- endif -%}
                    <fieldset class="opt" data-option-index="{{ forloop.index0 }}">
                      <legend class="opt-legend"><span>{{ option.name }}</span><span class="opt-value" data-option-value>{{ option.selected_value }}</span></legend>
                      <div class="opt-pills">
                        {%- assign opt_index = forloop.index0 -%}
                        {%- for value in option.values -%}
                          {%- assign vname = value.name | default: value -%}
                          {%- assign input_id = form_id | append: '-' | append: opt_index | append: '-' | append: forloop.index0 -%}
                          <input type="radio" class="visually-hidden" id="{{ input_id }}" name="{{ section.id }}-option-{{ opt_index }}" value="{{ vname | escape }}"{% if vname == option.selected_value %} checked{% endif %}>
                          <label for="{{ input_id }}" class="pill{% if value.available == false %} is-unavailable{% endif %}">{{ vname }}</label>
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}
                </div>
              {%- endunless -%}

            {%- when 'quantity' -%}
              <div class="pdp-qty" {{ block.shopify_attributes }}>
                <label class="opt-legend" for="{{ form_id }}-qty">{{ 'product.quantity' | t }}</label>
                <div class="qty qty--lg" data-qty-input>
                  <button type="button" data-step="-1" aria-label="{{ 'product.decrease' | t }}">{% render 'icon', icon: 'minus' %}</button>
                  <input type="number" id="{{ form_id }}-qty" name="quantity" form="{{ form_id }}" value="1" min="1" inputmode="numeric">
                  <button type="button" data-step="1" aria-label="{{ 'product.increase' | t }}">{% render 'icon', icon: 'plus' %}</button>
                </div>
              </div>

            {%- when 'buy_buttons' -%}
              <div class="pdp-buy" {{ block.shopify_attributes }}>
                <p class="stock stock--{{ status }}" data-stock>
                  <i aria-hidden="true"></i>
                  <span data-stock-text>
                    {%- case status -%}
                      {%- when 'available' -%}{{ 'product.in_stock' | t }}
                      {%- when 'soon' -%}{{ 'product.coming_soon' | t }}
                      {%- else -%}{{ 'product.sold_out' | t }}
                    {%- endcase -%}
                  </span>
                </p>
                {%- form 'product', product, id: form_id, class: 'pform', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                  <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>
                  <noscript>
                    {%- unless product.has_only_default_variant -%}
                      <label class="opt-legend" for="{{ form_id }}-noscript">{{ product.options | join: ' / ' }}</label>
                      <select id="{{ form_id }}-noscript" name="id">
                        {%- for v in product.variants -%}
                          <option value="{{ v.id }}"{% if v.id == current.id %} selected{% endif %}{% unless v.available %} disabled{% endunless %}>{{ v.title }}</option>
                        {%- endfor -%}
                      </select>
                    {%- endunless -%}
                  </noscript>
                  <button type="submit" name="add" class="btn btn--solid btn--block atc" data-atc{% unless status == 'available' %} disabled{% endunless %}>
                    <span class="atc-label" data-atc-label>
                      {%- case status -%}
                        {%- when 'available' -%}{{ 'product.add_to_cart' | t }}
                        {%- when 'soon' -%}{{ 'product.coming_soon' | t }}
                        {%- else -%}{{ 'product.sold_out' | t }}
                      {%- endcase -%}
                    </span>
                    <span class="atc-done" aria-hidden="true">{% render 'icon', icon: 'check' %}{{ 'product.added' | t }}</span>
                  </button>
                  {%- if block.settings.show_dynamic_checkout -%}
                    <div class="pdp-dynamic" data-dynamic{% unless status == 'available' %} hidden{% endunless %}>{{ form | payment_button }}</div>
                  {%- endif -%}
                  <p class="form-msg form-msg--err" data-atc-msg role="alert" hidden></p>
                {%- endform -%}
                {%- if settings.notify_enabled -%}
                  {% render 'notify-form', product: product, status: status, section_id: section.id %}
                {%- endif -%}
              </div>

            {%- when 'description' -%}
              <div class="pdp-desc rte" {{ block.shopify_attributes }}>
                {%- if product.description != blank -%}
                  {{ product.description }}
                {%- elsif request.design_mode -%}
                  <p class="editor-hint">{{ 'product.description_empty' | t }}</p>
                {%- endif -%}
              </div>

            {%- when 'notes' -%}
              {%- liquid
                assign top = product.metafields.custom.top_notes.value | join: ' · ' | default: block.settings.top
                assign heart = product.metafields.custom.heart_notes.value | join: ' · ' | default: block.settings.heart
                assign base = product.metafields.custom.base_notes.value | join: ' · ' | default: block.settings.base
              -%}
              {%- if top != blank or heart != blank or base != blank -%}
                <dl class="pdp-notes" {{ block.shopify_attributes }}>
                  {%- if block.settings.heading != blank -%}<p class="eyebrow">{{ block.settings.heading }}</p>{%- endif -%}
                  {%- if top != blank -%}<div><dt>{{ 'product.notes_top' | t }}</dt><dd>{{ top }}</dd></div>{%- endif -%}
                  {%- if heart != blank -%}<div><dt>{{ 'product.notes_heart' | t }}</dt><dd>{{ heart }}</dd></div>{%- endif -%}
                  {%- if base != blank -%}<div><dt>{{ 'product.notes_base' | t }}</dt><dd>{{ base }}</dd></div>{%- endif -%}
                </dl>
              {%- elsif request.design_mode -%}
                <p class="editor-hint" {{ block.shopify_attributes }}>{{ 'product.notes_empty' | t }}</p>
              {%- endif -%}

            {%- when 'accordion' -%}
              {%- if block.settings.content != blank or block.settings.page != blank -%}
                <details class="acc" {{ block.shopify_attributes }}{% if block.settings.open %} open{% endif %}>
                  <summary><span>{{ block.settings.title }}</span>{% render 'icon', icon: 'plus' %}</summary>
                  <div class="acc-body rte">
                    {{ block.settings.content }}
                    {%- if block.settings.page != blank -%}{{ block.settings.page.content }}{%- endif -%}
                  </div>
                </details>
              {%- endif -%}

            {%- when 'text' -%}
              <div class="rte pdp-text" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

            {%- when 'custom_liquid' -%}
              <div {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>

            {%- when '@app' -%}
              {% render block %}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- if s.sticky_bar -%}
    <div class="sticky-atc scheme-{{ s.color_scheme }}" data-sticky-atc aria-hidden="true">
      <div class="sticky-atc-inner wrap">
        <div class="sticky-atc-info">
          <span class="sticky-atc-title">{{ product.title }}</span>
          <span class="sticky-atc-price" data-sticky-price>{% render 'money', amount: current.price %}</span>
        </div>
        <button type="submit" form="{{ form_id }}" class="btn btn--solid btn--sm" data-sticky-btn tabindex="-1"{% unless status == 'available' %} disabled{% endunless %}>
          <span data-sticky-label>
            {%- case status -%}
              {%- when 'available' -%}{{ 'product.add_to_cart' | t }}
              {%- when 'soon' -%}{{ 'product.coming_soon' | t }}
              {%- else -%}{{ 'product.sold_out' | t }}
            {%- endcase -%}
          </span>
        </button>
      </div>
    </div>
  {%- endif -%}

  <script type="application/json" data-product-json>{{ product | json }}</script>
</section>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {%- if product.featured_media -%}
    "image": [{{ product.featured_media | image_url: width: 1200 | prepend: 'https:' | json }}],
    {%- endif -%}
    "description": {{ product.description | strip_html | strip | json }},
    "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
    "offers": [
      {%- for v in product.variants -%}
      {
        "@type": "Offer",
        "sku": {{ v.sku | json }},
        "availability": "http://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}",
        "price": {{ v.price | divided_by: 100.0 | json }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "url": {{ request.origin | append: v.url | json }}
      }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

{% schema %}
{
  "name": "Produktseite",
  "tag": "div",
  "class": "section-main-product",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Farbschema", "default": "dark", "options": [
      { "value": "dark", "label": "Nacht" }, { "value": "light", "label": "Pergament" }, { "value": "sand", "label": "Sand" }
    ] },
    { "type": "select", "id": "fallback_art", "label": "Ersatz-Illustration ohne Produktbilder", "default": "relic", "options": [
      { "value": "zeus", "label": "Flakon Gewitter" }, { "value": "pharaon", "label": "Flakon Wüste" }, { "value": "relic", "label": "Sanduhr" }, { "value": "veil", "label": "Verhüllt" }
    ] },
    { "type": "checkbox", "id": "sticky_bar", "label": "Kauf-Leiste beim Scrollen (Handy)", "default": true }
  ],
  "blocks": [
    { "type": "eyebrow", "name": "Kleine Zeile", "limit": 1, "settings": [
      { "type": "text", "id": "text", "label": "Text", "info": "Leer = Metafeld custom.era des Produkts" }
    ] },
    { "type": "title", "name": "Titel", "limit": 1, "settings": [] },
    { "type": "subtitle", "name": "Unterzeile", "limit": 1, "settings": [
      { "type": "text", "id": "text", "label": "Text", "info": "Leer = Metafeld custom.subtitle, sonst Produkttyp" }
    ] },
    { "type": "price", "name": "Preis", "limit": 1, "settings": [] },
    { "type": "variant_picker", "name": "Variantenauswahl", "limit": 1, "settings": [
      { "type": "checkbox", "id": "hide_single", "label": "Optionen mit nur einem Wert ausblenden", "default": false }
    ] },
    { "type": "quantity", "name": "Menge", "limit": 1, "settings": [] },
    { "type": "buy_buttons", "name": "Kaufen-Button", "limit": 1, "settings": [
      { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Express-Checkout-Buttons (z. B. Shop Pay)", "default": false }
    ] },
    { "type": "description", "name": "Beschreibung", "limit": 1, "settings": [] },
    { "type": "notes", "name": "Duftnoten (kurz)", "limit": 1, "settings": [
      { "type": "paragraph", "content": "Nutzt die Produkt-Metafelder custom.top_notes, custom.heart_notes und custom.base_notes. Die Felder unten gelten nur, wenn ein Metafeld leer ist." },
      { "type": "text", "id": "heading", "label": "Überschrift", "default": "Notes" },
      { "type": "text", "id": "top", "label": "Kopfnoten" },
      { "type": "text", "id": "heart", "label": "Herznoten" },
      { "type": "text", "id": "base", "label": "Basisnoten" }
    ] },
    { "type": "accordion", "name": "Aufklappbereich", "settings": [
      { "type": "text", "id": "title", "label": "Titel", "default": "Details" },
      { "type": "richtext", "id": "content", "label": "Inhalt" },
      { "type": "page", "id": "page", "label": "Inhalt aus Seite" },
      { "type": "checkbox", "id": "open", "label": "Anfangs geöffnet", "default": false }
    ] },
    { "type": "text", "name": "Text", "settings": [
      { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Text</p>" }
    ] },
    { "type": "custom_liquid", "name": "Eigener Code", "settings": [
      { "type": "liquid", "id": "custom_liquid", "label": "Liquid" }
    ] },
    { "type": "@app" }
  ]
}
{% endschema %}
