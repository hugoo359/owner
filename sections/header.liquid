{%- liquid
  assign menu = section.settings.menu
  assign transparent = false
  if section.settings.transparent_home and template.name == 'index'
    assign transparent = true
  endif
  if section.settings.transparent_story and template.suffix == 'story'
    assign transparent = true
  endif
  assign numerals = 'I,II,III,IV,V,VI,VII,VIII,IX,X,XI,XII' | split: ','
  assign link_count = menu.links.size
  assign half = link_count | plus: 1 | divided_by: 2
-%}
{%- if transparent -%}
  <script>document.body.classList.add('transparent-header');</script>
{%- endif -%}

<header class="hdr hdr--{{ section.settings.layout }}{% if transparent %} over{% endif %}" id="SiteNav">
  <div class="hdr-left">
    <button class="hdr-burger" type="button" data-open="mnav" aria-controls="mnav" aria-expanded="false" aria-label="{{ 'general.open_menu' | t }}">
      {% render 'icon', icon: 'burger' %}
    </button>
    <nav class="hdr-nav" aria-label="{{ 'header.main_menu' | t }}">
      <ul class="hdr-links">
        {%- for link in menu.links -%}
          {%- if section.settings.layout == 'split' and forloop.index > half -%}{%- break -%}{%- endif -%}
          {% render 'header-link', link: link %}
        {%- endfor -%}
      </ul>
    </nav>
  </div>

  <a href="{{ routes.root_url }}" class="hdr-logo logo-link" aria-label="{{ shop.name }}">
    {% render 'logo', eager: true, size: 'sm' %}
  </a>

  <div class="hdr-right">
    {%- if section.settings.layout == 'split' -%}
      <ul class="hdr-links hdr-links--right">
        {%- for link in menu.links offset: half -%}
          {% render 'header-link', link: link %}
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {%- if section.settings.show_search -%}
      <button type="button" class="hdr-icon" data-open="search" aria-label="{{ 'header.open_search' | t }}">{% render 'icon', icon: 'search' %}</button>
    {%- endif -%}
    {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
      <a class="hdr-icon" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" rel="nofollow" aria-label="{% if customer %}{{ 'general.my_account' | t }}{% else %}{{ 'general.log_in' | t }}{% endif %}">{% render 'icon', icon: 'account' %}</a>
    {%- endif -%}
    <a href="{{ routes.cart_url }}" data-open="cart" class="hdr-cart cart-icon" id="CartIcon" aria-label="{{ 'header.open_cart' | t }}">
      <span class="hdr-cart-icon">{% render 'icon', icon: 'bag' %}</span>
      <span class="hdr-cart-label">{{ 'header.cart' | t }}</span>
      <span class="cart-count" id="CartCount" data-count="{{ cart.item_count }}">{{ cart.item_count }}</span>
    </a>
  </div>
</header>

<div id="mnav" class="layer mnav" hidden>
  <div class="mnav-panel scheme-dark" role="dialog" aria-modal="true" aria-label="{{ 'general.menu' | t }}">
    <div class="mnav-top">
      <button type="button" class="mnav-close" data-close="mnav" aria-label="{{ 'general.close_menu' | t }}">{% render 'icon', icon: 'close' %}</button>
      <a href="{{ routes.root_url }}" class="logo-link">{% render 'logo' %}</a>
      <a href="{{ routes.cart_url }}" data-open="cart" class="mnav-cart" aria-label="{{ 'header.open_cart' | t }}">{% render 'icon', icon: 'bag' %}</a>
    </div>
    <nav class="mnav-links" aria-label="{{ 'header.main_menu' | t }}">
      <ul>
        {%- for link in menu.links -%}
          <li style="--i: {{ forloop.index0 }}">
            {%- if link.links.size > 0 -%}
              <details class="mnav-sub">
                <summary>
                  {%- if section.settings.menu_numerals -%}<span class="mnav-num">{{ numerals[forloop.index0] }}</span>{%- endif -%}
                  <span class="mnav-title">{{ link.title }}</span>{% render 'icon', icon: 'plus' %}
                </summary>
                <ul>
                  {%- for child in link.links -%}
                    <li><a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title }}</a></li>
                  {%- endfor -%}
                </ul>
              </details>
            {%- else -%}
              <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>
                {%- if section.settings.menu_numerals -%}<span class="mnav-num">{{ numerals[forloop.index0] }}</span>{%- endif -%}
                <span class="mnav-title">{{ link.title }}</span>
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>
    <div class="mnav-foot">
      {%- if section.settings.mobile_note != blank -%}<p class="eyebrow">{{ section.settings.mobile_note }}</p>{%- endif -%}
      {% render 'social-links' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menü", "default": "main-menu", "info": "Empfohlen: Zeus, Pharaon, The Story, Contact. Untermenüs erscheinen als Dropdown." },
    { "type": "select", "id": "layout", "label": "Anordnung", "default": "center", "options": [
      { "value": "center", "label": "Links Menü, Logo mittig" },
      { "value": "split", "label": "Menü links und rechts vom Logo" },
      { "value": "left", "label": "Logo links, Menü daneben" }
    ] },
    { "type": "checkbox", "id": "transparent_home", "label": "Startseite: transparent über dem ersten Bereich", "default": true },
    { "type": "checkbox", "id": "transparent_story", "label": "„The Story“-Seite: transparent über dem ersten Bereich", "default": true },
    { "type": "checkbox", "id": "show_search", "label": "Suche anzeigen", "default": false },
    { "type": "checkbox", "id": "show_account", "label": "Kundenkonto anzeigen", "default": false },
    { "type": "header", "content": "Mobiles Menü" },
    { "type": "checkbox", "id": "menu_numerals", "label": "Römische Ziffern vor den Menüpunkten", "default": true },
    { "type": "text", "id": "mobile_note", "label": "Kurzer Text unten im Menü", "default": "Extraits de Parfum" }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
