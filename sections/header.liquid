{%- liquid
  assign menu = section.settings.menu
  assign transparent = false
  if section.settings.transparent_home and template.name == 'index'
    assign transparent = true
  endif
-%}
{%- if transparent -%}
  <script>document.body.classList.add('transparent-header');</script>
{%- endif -%}

<header class="nav{% if transparent %} over{% endif %}" id="SiteNav">
  <div class="nav-left">
    <button class="burger" type="button" data-open="mnav" aria-label="Menü öffnen">{% render 'icon', icon: 'burger' %}</button>
    <ul class="nav-links">
      {%- for link in menu.links -%}
        {%- if link.links.size > 0 -%}
          {%- liquid
            assign has_cols = false
            for child in link.links
              if child.links.size > 0
                assign has_cols = true
              endif
            endfor
          -%}
          <li class="has-mega">
            <a href="{{ link.url }}" aria-haspopup="true">{{ link.title }}</a>
            <div class="mega">
              {%- if has_cols -%}
                {%- for child in link.links -%}
                  <div>
                    <h4><a href="{{ child.url }}">{{ child.title }}</a></h4>
                    {%- if child.links.size > 0 -%}
                      <ul>
                        {%- for grandchild in child.links -%}
                          <li><a href="{{ grandchild.url }}">{{ grandchild.title }}</a></li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </div>
                {%- endfor -%}
              {%- else -%}
                <div>
                  <h4><a href="{{ link.url }}">{{ link.title }}</a></h4>
                  <ul>
                    {%- for child in link.links -%}
                      <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                    {%- endfor -%}
                  </ul>
                </div>
              {%- endif -%}
            </div>
          </li>
        {%- else -%}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>

  <a href="{{ routes.root_url }}" class="logo-link" aria-label="{{ shop.name }}">{% render 'logo' %}</a>

  <div class="nav-right">
    {%- if shop.customer_accounts_enabled -%}
      <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" data-open="account" class="account-icon{% if customer %} is-in{% endif %}" aria-label="{% if customer %}Mein Konto{% else %}Anmelden{% endif %}" rel="nofollow">
        {% render 'icon', icon: 'account' %}
      </a>
    {%- endif -%}
    <button type="button" data-open="search" aria-label="Suche öffnen">{% render 'icon', icon: 'search' %}</button>
    <a href="{{ routes.cart_url }}" data-open="cart" class="cart-icon" id="CartIcon" aria-label="Warenkorb öffnen">
      {% render 'icon', icon: 'cart' %}
      <span class="cart-count" id="CartCount"{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
    </a>
  </div>
</header>

<div id="mnav" class="layer" hidden>
  <div class="backdrop" data-close="mnav"></div>
  <nav class="panel" aria-label="Menü">
    <button type="button" class="mnav-close" data-close="mnav" aria-label="Menü schließen">{% render 'icon', icon: 'close' %}</button>
    {%- for link in menu.links -%}
      {%- if link.links.size > 0 -%}
        <h4>{{ link.title }}</h4>
        {%- for child in link.links -%}
          <a href="{{ child.url }}">{{ child.title }}</a>
          {%- for grandchild in child.links -%}
            <a href="{{ grandchild.url }}" class="sub">{{ grandchild.title }}</a>
          {%- endfor -%}
        {%- endfor -%}
      {%- else -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endif -%}
    {%- endfor -%}
    {%- if shop.customer_accounts_enabled -%}
      <h4>Konto</h4>
      <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" data-open="account" data-no-transition>{% if customer %}Mein Konto{% else %}Anmelden{% endif %}</a>
    {%- endif -%}
  </nav>
</div>

{%- if shop.customer_accounts_enabled -%}
  {%- liquid
    if section.settings.login_return == 'storefront'
      assign login_url = routes.storefront_login_url
    else
      assign login_url = routes.account_login_url
    endif
    assign url_parts = routes.account_url | split: '?'
    assign base_url = url_parts | first
    assign query = ''
    if url_parts.size > 1
      assign query = '?' | append: url_parts.last
    endif
  -%}
  <div id="account" class="layer" hidden>
    <div class="backdrop" data-close="account"></div>
    <aside class="drawer account-drawer" aria-label="Konto" role="dialog">
      <div class="d-head">
        <h2>{% if customer %}MEIN KONTO{% else %}ANMELDEN{% endif %}</h2>
        <button type="button" data-close="account" aria-label="Schließen">{% render 'icon', icon: 'close-thin' %}</button>
      </div>
      <div class="d-scroll account-body">
        {%- if customer -%}
          <div class="acc-hello">
            <span class="acc-avatar" aria-hidden="true">{{ customer.first_name | default: customer.email | slice: 0 | upcase }}</span>
            <div>
              <p class="acc-name">Hallo{% if customer.first_name != blank %} {{ customer.first_name }}{% endif %}!</p>
              <p class="acc-mail">{{ customer.email }}</p>
            </div>
          </div>
          {%- assign last_order = customer.orders.first -%}
          {%- if last_order -%}
            <a class="acc-order" href="{{ last_order.customer_url | default: routes.account_url }}" data-no-transition>
              <span class="acc-label">Letzte Bestellung</span>
              <span class="acc-order-row"><b>{{ last_order.name }}</b><span>{{ last_order.created_at | date: '%d.%m.%Y' }}</span></span>
              <span class="acc-order-row"><span>{{ last_order.fulfillment_status_label }}</span><span>{{ last_order.total_price | money_with_currency }}</span></span>
            </a>
          {%- endif -%}
          <nav class="acc-links">
            <a href="{{ routes.account_url }}" data-no-transition>Bestellungen <span aria-hidden="true">→</span></a>
            <a href="{{ base_url }}/profile{{ query }}" data-no-transition>Profil &amp; Adressen <span aria-hidden="true">→</span></a>
          </nav>
          <a class="btn-outline acc-logout" href="{{ routes.account_logout_url }}" data-no-transition>Abmelden</a>
        {%- else -%}
          <p class="acc-intro">{{ section.settings.login_text }}</p>
          {%- capture shop_btn -%}{{ shop | login_button }}{%- endcapture -%}
          {%- if shop_btn != blank -%}
            <div class="shop-login">{{ shop_btn }}</div>
            <div class="acc-or"><span>oder</span></div>
          {%- endif -%}
          <a class="atc acc-email" href="{{ login_url }}" rel="nofollow" data-no-transition>
            <span class="atc-label">Mit E-Mail anmelden</span>
          </a>
          {%- if routes.account_register_url != blank -%}
            <a class="acc-register link-u" href="{{ routes.account_register_url }}" data-no-transition>Noch kein Konto? Jetzt erstellen</a>
          {%- endif -%}
          <ul class="acc-perks">
            <li>{% render 'icon', icon: 'check' %}Bestellungen jederzeit verfolgen</li>
            <li>{% render 'icon', icon: 'check' %}Schneller bezahlen mit gespeicherten Daten</li>
            <li>{% render 'icon', icon: 'check' %}Früher Zugang zu neuen Düften</li>
          </ul>
        {%- endif -%}
      </div>
    </aside>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menü", "default": "main-menu", "info": "Untermenüs erscheinen als Dropdown. Drei Ebenen ergeben mehrere Spalten." },
    { "type": "checkbox", "id": "transparent_home", "label": "Auf der Startseite transparent über dem Hero", "default": true },
    { "type": "header", "content": "Konto" },
    { "type": "select", "id": "login_return", "label": "Nach der Anmeldung weiter zu", "default": "account", "options": [
      { "value": "account", "label": "Bestellübersicht im Kundenkonto" },
      { "value": "storefront", "label": "Zurück zur Seite im Shop" }
    ] },
    { "type": "text", "id": "login_text", "label": "Text in der Anmelde-Leiste", "default": "Melde dich an, um deine Bestellungen zu sehen und schneller zu bezahlen." }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
