<section class="richtext richtext--{{ section.settings.align }}" style="--rt-bg: {{ section.settings.bg }}; --rt-ink: {{ section.settings.ink }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px">
  <div class="richtext-inner" data-reveal>
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'kicker' -%}
          <p class="rt-kicker" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
        {%- when 'heading' -%}
          <h2 class="rt-title rt-title--{{ block.settings.size }}" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
        {%- when 'text' -%}
          <div class="rt-text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- when 'button' -%}
          {%- if block.settings.label != blank -%}
            <a class="{% if block.settings.style == 'outline' %}btn-outline rt-btn-outline{% else %}atc inline{% endif %}" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
          {%- endif -%}
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Text",
  "tag": "div",
  "settings": [
    { "type": "select", "id": "align", "label": "Ausrichtung", "default": "center", "options": [
      { "value": "left", "label": "Links" },
      { "value": "center", "label": "Mitte" }
    ] },
    { "type": "color", "id": "bg", "label": "Hintergrund", "default": "#ffffff" },
    { "type": "color", "id": "ink", "label": "Textfarbe", "default": "#111111" },
    { "type": "range", "id": "padding_top", "label": "Abstand oben", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Abstand unten", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 72 }
  ],
  "blocks": [
    { "type": "kicker", "name": "Kleine Zeile", "limit": 1, "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "ÜBER UNS" } ] },
    { "type": "heading", "name": "Überschrift", "settings": [
      { "type": "text", "id": "heading", "label": "Überschrift", "default": "MADE TO BE WORN" },
      { "type": "select", "id": "size", "label": "Größe", "default": "m", "options": [
        { "value": "s", "label": "Klein" }, { "value": "m", "label": "Mittel" }, { "value": "l", "label": "Groß" }
      ] }
    ] },
    { "type": "text", "name": "Text", "settings": [ { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Erzähle hier deine Geschichte, stelle eine Kollektion vor oder teile News mit deinen Kund:innen.</p>" } ] },
    { "type": "button", "name": "Button", "limit": 2, "settings": [
      { "type": "text", "id": "label", "label": "Text", "default": "Mehr erfahren" },
      { "type": "url", "id": "link", "label": "Link" },
      { "type": "select", "id": "style", "label": "Stil", "default": "solid", "options": [
        { "value": "solid", "label": "Gefüllt" }, { "value": "outline", "label": "Umrandet" }
      ] }
    ] }
  ],
  "presets": [ { "name": "Text", "blocks": [ { "type": "kicker" }, { "type": "heading" }, { "type": "text" }, { "type": "button" } ] } ]
}
{% endschema %}
