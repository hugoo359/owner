{%- comment -%}
  Marken-Text für die Startseite: zentrierte Überschrift, Textgruppen und Social-Icons.
  Social-Links kommen aus Theme-Einstellungen → Social Media.
{%- endcomment -%}
{%- if section.settings.font == 'michroma' -%}
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Michroma&display=swap">
{%- endif -%}
<style>
  #Brand-{{ section.id }}{
    --bs-bg: {{ section.settings.bg }};
    --bs-ink: {{ section.settings.ink }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
</style>
<section id="Brand-{{ section.id }}" class="brand-story{% if section.settings.font == 'michroma' %} brand-story--wide{% endif %}">
  <div class="bs-inner" data-reveal>
    {%- if section.settings.heading != blank -%}
      <h2 class="bs-title">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- for block in section.blocks -%}
      <div class="bs-text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
    {%- endfor -%}
  </div>

  {%- liquid
    assign has_social = false
    if settings.social_instagram != blank or settings.social_youtube != blank or settings.social_tiktok != blank or settings.social_whatsapp != blank
      assign has_social = true
    endif
  -%}
  {%- if section.settings.show_social and has_social -%}
    <div class="bs-social">
      {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'icon', icon: 'instagram' %}</a>{%- endif -%}
      {%- if settings.social_youtube != blank -%}<a href="{{ settings.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube">{% render 'icon', icon: 'youtube' %}</a>{%- endif -%}
      {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">{% render 'icon', icon: 'tiktok' %}</a>{%- endif -%}
      {%- if settings.social_whatsapp != blank -%}<a href="{{ settings.social_whatsapp }}" target="_blank" rel="noopener" aria-label="WhatsApp">{% render 'icon', icon: 'whatsapp' %}</a>{%- endif -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Marken-Text",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "NONEOFUS - PARFUM" },
    { "type": "select", "id": "font", "label": "Schrift", "default": "michroma", "options": [
      { "value": "michroma", "label": "Breit (Michroma)" },
      { "value": "theme", "label": "Theme-Schrift" }
    ] },
    { "type": "color", "id": "bg", "label": "Hintergrund", "default": "#eeece8" },
    { "type": "color", "id": "ink", "label": "Textfarbe", "default": "#1a1a1a" },
    { "type": "checkbox", "id": "show_social", "label": "Social-Icons anzeigen", "default": true, "info": "Links unter Theme-Einstellungen → Social Media eintragen." },
    { "type": "range", "id": "padding_top", "label": "Abstand oben", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_bottom", "label": "Abstand unten", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 32 }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Textabschnitt",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "info": "Jeder Absatz wird als eigene Zeile angezeigt. Zwischen Textabschnitten entsteht ein Abstand." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marken-Text",
      "blocks": [
        { "type": "text", "settings": { "text": "<p>Wir sind <strong>NoneofUs</strong> – eine Parfummarke, entstanden aus Leidenschaft, Ausdauer und dem Wunsch, etwas Echtes zu schaffen.</p><p>Wir kommen nicht aus großen Parfumhäusern, sondern aus kleinen Laboren, langen Nächten und hunderten Testflakons.</p><p>Was als Traum begann, ist zu einer Bewegung geworden.</p>" } },
        { "type": "text", "settings": { "text": "<p><strong>NoneofUs</strong> steht für Zusammenhalt, Echtheit und Qualität.</p><p>Wir kreieren Düfte, die nicht nur gut riechen, sondern sich richtig anfühlen – hochwertig komponiert, lange haltbar und gemacht, um im Gedächtnis zu bleiben.</p>" } },
        { "type": "text", "settings": { "text": "<p>Wir glauben, dass jeder Mensch eine Geschichte hat, die es wert ist, erzählt zu werden – und jeder Duft erzählt eine.</p><p>Egal, woher du kommst, was du trägst oder wie du denkst – <strong>du gehörst dazu.</strong></p>" } },
        { "type": "text", "settings": { "text": "<p><strong>NoneofUs – not one above.</strong></p>" } }
      ]
    }
  ]
}
{% endschema %}
