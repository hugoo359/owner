{%- paginate search.results by 24 -%}
<div class="wrap search-page">
  <h1 class="ctitle">{{ 'search.title' | t }}</h1>
  <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
    {% render 'icon', icon: 'search-sm' %}
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}" aria-label="{{ 'search.label' | t }}">
    <input type="hidden" name="options[prefix]" value="last">
    <button type="submit">{{ 'search.submit' | t }}</button>
  </form>
  {%- if search.performed -%}
    <p class="result-count">{{ 'search.results_count' | t: count: search.results_count, terms: search.terms }}</p>
    <div class="grid" style="--cols: 4">
      {%- for item in search.results -%}
        {%- if item.object_type == 'product' -%}
          {% render 'product-card', product: item %}
        {%- else -%}
          <a class="card text-card" href="{{ item.url }}"><h3>{{ item.title }}</h3><p>{{ item.content | strip_html | truncatewords: 20 }}</p></a>
        {%- endif -%}
      {%- else -%}
        <div class="empty">{{ 'search.no_results' | t }}</div>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}{% render 'pagination', paginate: paginate %}{%- endif -%}
  {%- endif -%}
</div>
{%- endpaginate -%}

{% schema %}
{ "name": "Suchergebnisse" }
{% endschema %}
