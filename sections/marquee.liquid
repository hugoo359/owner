{%- comment -%} Laufband mit kurzen Botschaften (z. B. Versand, Umtausch, Qualität). {%- endcomment -%}
{%- capture mq_label -%}{%- for block in section.blocks -%}{{ block.settings.text }}{% unless forloop.last %} · {% endunless %}{%- endfor -%}{%- endcapture -%}
<section class="marquee" style="--mq-bg: {{ section.settings.bg }}; --mq-ink: {{ section.settings.ink }}; --mq-speed: {{ section.settings.speed }}s" role="region" aria-label="{{ mq_label | strip | escape }}">
  <div class="mq-track" aria-hidden="true">
    {%- for i in (1..2) -%}
      <div class="mq-group">
        {%- for block in section.blocks -%}
          {%- for r in (1..3) -%}
            <span class="mq-item" {% if i == 1 and r == 1 %}{{ block.shopify_attributes }}{% endif %}>{{ block.settings.text }}</span>
            <span class="mq-sep">{{ section.settings.separator }}</span>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Laufband",
  "tag": "div",
  "settings": [
    { "type": "color", "id": "bg", "label": "Hintergrund", "default": "#111111" },
    { "type": "color", "id": "ink", "label": "Textfarbe", "default": "#ffffff" },
    { "type": "text", "id": "separator", "label": "Trennzeichen", "default": "✦" },
    { "type": "range", "id": "speed", "label": "Dauer pro Durchlauf", "min": 10, "max": 80, "step": 2, "unit": "s", "default": 30 }
  ],
  "blocks": [
    { "type": "item", "name": "Text", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Kostenloser Versand ab 125 €" } ] }
  ],
  "max_blocks": 6,
  "presets": [
    { "name": "Laufband", "blocks": [
      { "type": "item", "settings": { "text": "Kostenloser Versand ab 125 €" } },
      { "type": "item", "settings": { "text": "14 Tage kostenloser Umtausch" } },
      { "type": "item", "settings": { "text": "Heavyweight Cotton" } }
    ] }
  ]
}
{% endschema %}
