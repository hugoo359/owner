{%- paginate blog.articles by 12 -%}
<div class="wrap page-wrap">
  <h1 class="ctitle">{{ blog.title }}</h1>
  <div class="grid" style="--cols: 3">
    {%- for article in blog.articles -%}
      <a class="card" href="{{ article.url }}">
        <div class="media">
          {%- if article.image -%}{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: article.title }}{%- else -%}{{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
        </div>
        <h3>{{ article.title }}</h3>
        <div class="price">{{ article.published_at | date: '%d.%m.%Y' }}</div>
      </a>
    {%- endfor -%}
  </div>
  {%- if paginate.pages > 1 -%}{% render 'pagination', paginate: paginate %}{%- endif -%}
</div>
{%- endpaginate -%}
{% schema %}
{ "name": "Blog" }
{% endschema %}
