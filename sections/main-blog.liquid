{%- paginate blog.articles by 12 -%}
<section class="collection scheme-dark section-pad">
  <div class="wrap">
    <header class="sec-head sec-head--center"><h1 class="h1" data-split>{{ blog.title }}</h1></header>
    <div class="fcol-grid" style="--cols: 3">
      {%- for article in blog.articles -%}
        <article class="fcard" data-reveal>
          <a class="fcard-media" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
            {%- if article.image -%}{{ article.image | image_url: width: 1100 | image_tag: class: 'fcard-img', loading: 'lazy', alt: '' }}{%- else -%}{% render 'fallback-art', art: 'dunes', class: 'fcard-img' %}{%- endif -%}
          </a>
          <div class="fcard-body">
            <p class="eyebrow">{{ article.published_at | date: '%b %d, %Y' }}</p>
            <h2 class="fcard-title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
          </div>
        </article>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}{% render 'pagination', paginate: paginate %}{%- endif -%}
  </div>
</section>
{%- endpaginate -%}
{% schema %}
{ "name": "Blog", "tag": "div" }
{% endschema %}
