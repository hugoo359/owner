{%- liquid
  assign tab_count = 0
  for i in (1..3)
    assign key = 'tab_' | append: i
    if section.settings[key] != blank
      assign tab_count = i
    endif
  endfor
-%}
<section class="home-sec ft" data-tabs style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px">
  <div class="section-head">
    <h2 class="sh-title split-title" data-split>{{ section.settings.heading }}</h2>
  </div>

  {%- if tab_count > 1 -%}
    <div class="ft-tabs" role="tablist" data-reveal>
      {%- for i in (1..tab_count) -%}
        {%- assign key = 'tab_' | append: i -%}
        {%- if section.settings[key] != blank -%}
          <button type="button" role="tab" class="ft-tab{% if forloop.first %} on{% endif %}" data-tab-btn="{{ i }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}">{{ section.settings[key] }}</button>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  <div class="ft-grid" data-tab-grid style="--cols: {{ section.settings.columns }}">
    {%- for block in section.blocks -%}
      {%- assign show = false -%}
      {%- if tab_count <= 1 or block.settings.tab == '1' -%}{%- assign show = true -%}{%- endif -%}
      <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="ft-card{% unless show %} is-hidden{% endunless %}" data-tab="{{ block.settings.tab }}" data-reveal {{ block.shopify_attributes }}>
        <div class="ft-media">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 1100px) 25vw, 80vw', widths: '400, 600, 900, 1200', alt: block.settings.image.alt }}
          {%- else -%}
            {%- assign odd = forloop.index | modulo: 2 -%}
            {%- if odd == 1 -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}{%- else -%}{{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
          {%- endif -%}
          <span class="ft-cta">Discover <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 6h8M7 3l3 3-3 3"/></svg></span>
        </div>
        <h3>{{ block.settings.title }}</h3>
        {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Bildkarten mit Tabs",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "TRENDING NOW" },
    { "type": "text", "id": "tab_1", "label": "Tab 1", "default": "Women" },
    { "type": "text", "id": "tab_2", "label": "Tab 2", "default": "Men" },
    { "type": "text", "id": "tab_3", "label": "Tab 3", "info": "Leer lassen, wenn du nur zwei Tabs willst. Nur ein Tab = keine Tab-Buttons." },
    { "type": "range", "id": "columns", "label": "Karten nebeneinander (Desktop)", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "range", "id": "padding_top", "label": "Abstand oben", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Abstand unten", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Karte",
      "settings": [
        { "type": "select", "id": "tab", "label": "Gehört zu Tab", "default": "1", "options": [
          { "value": "1", "label": "Tab 1" }, { "value": "2", "label": "Tab 2" }, { "value": "3", "label": "Tab 3" }
        ] },
        { "type": "image_picker", "id": "image", "label": "Bild", "info": "Hochformat, z. B. 900 × 1125 px" },
        { "type": "text", "id": "title", "label": "Titel", "default": "New: Essentials" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Our everyday basics. Heavyweight fabric, clean cut." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    { "name": "Bildkarten mit Tabs", "blocks": [
      { "type": "card", "settings": { "tab": "1", "title": "New: Essentials" } },
      { "type": "card", "settings": { "tab": "1", "title": "Bestsellers" } },
      { "type": "card", "settings": { "tab": "2", "title": "New: Essentials" } },
      { "type": "card", "settings": { "tab": "2", "title": "Bestsellers" } }
    ] }
  ]
}
{% endschema %}
