{%- liquid
  assign msgs = 0
  if section.settings.text != blank
    assign msgs = msgs | plus: 1
  endif
  if section.settings.text_2 != blank
    assign msgs = msgs | plus: 1
  endif
  if section.settings.text_3 != blank
    assign msgs = msgs | plus: 1
  endif
-%}
{%- if msgs > 0 -%}
  <div class="topbar" data-ticker data-interval="{{ section.settings.interval }}">
    {%- for i in (1..3) -%}
      {%- liquid
        case i
          when 1
            assign t = section.settings.text
          when 2
            assign t = section.settings.text_2
          when 3
            assign t = section.settings.text_3
        endcase
      -%}
      {%- if t != blank -%}
        <span class="msg{% if forloop.first %} on{% endif %}">
          {%- if section.settings.link != blank -%}<a href="{{ section.settings.link }}">{{ t }}</a>{%- else -%}{{ t }}{%- endif -%}
        </span>
      {%- endif -%}
    {%- endfor -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Ankündigungsleiste",
  "class": "section-announcement",
  "settings": [
    { "type": "text", "id": "text", "label": "Text 1", "default": "Kostenloser Versand ab 125 €" },
    { "type": "text", "id": "text_2", "label": "Text 2", "default": "14 Tage Rückgaberecht (versiegelt)" },
    { "type": "text", "id": "text_3", "label": "Text 3", "default": "Versand in 2–4 Tagen" },
    { "type": "range", "id": "interval", "label": "Wechsel alle", "min": 2, "max": 10, "step": 1, "unit": "s", "default": 4 },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
