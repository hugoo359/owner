{%- liquid
  assign msgs = section.blocks | where: 'type', 'message'
-%}
{%- if msgs.size > 0 -%}
  <div class="topbar scheme-{{ section.settings.color_scheme }}" data-ticker data-interval="{{ section.settings.interval }}">
    {%- for block in msgs -%}
      <p class="msg{% if forloop.first %} on{% endif %}" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>{%- else -%}{{ block.settings.text }}{%- endif -%}
      </p>
    {%- endfor -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Ankündigungsleiste",
  "class": "section-announcement",
  "settings": [
    { "type": "range", "id": "interval", "label": "Wechsel alle", "min": 2, "max": 10, "step": 1, "unit": "s", "default": 5 },
    { "type": "select", "id": "color_scheme", "label": "Farbschema", "default": "sand", "options": [
      { "value": "dark", "label": "Nacht" },
      { "value": "light", "label": "Pergament" },
      { "value": "sand", "label": "Sand" }
    ] }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Nachricht",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Extraits de parfum · 100 ml" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
