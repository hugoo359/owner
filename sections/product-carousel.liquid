{%- liquid
  assign coll = section.settings.collection
  if coll == blank
    assign coll = collections.all
  endif
-%}
<section class="home-sec pc" data-carousel style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px">
  <div class="section-head">
    <h2 class="sh-title split-title" data-split>{{ section.settings.heading }}</h2>
    {%- if section.settings.link_label != blank -%}
      <a class="sh-link link-u" href="{{ coll.url }}">{{ section.settings.link_label }}</a>
    {%- endif -%}
    <div class="sh-arrows">
      <button type="button" class="car-btn" data-car-prev aria-label="Previous" disabled>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
      </button>
      <button type="button" class="car-btn" data-car-next aria-label="Next">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
      </button>
    </div>
  </div>

  <div class="carousel" data-car-track style="--per: {{ section.settings.per_view }}">
    {%- for product in coll.products limit: section.settings.limit -%}
      {% render 'product-card-slide', product: product, badge: section.settings.badge, badge_label: section.settings.badge_label, subtitle: section.settings.subtitle %}
    {%- else -%}
      {%- for i in (1..6) -%}
        <div class="card slide-card" data-reveal>
          <div class="card-media"><div class="media">{{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}</div><span class="badge">{{ section.settings.badge_label }}</span></div>
          <div class="card-info"><h3>Product name</h3><p class="card-sub">Color</p><div class="price">{{ 4900 | money }}</div></div>
        </div>
      {%- endfor -%}
    {%- endfor -%}
  </div>
  <div class="car-progress" aria-hidden="true"><i data-car-bar></i></div>
</section>

{% schema %}
{
  "name": "Produkt-Slider",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "NEW: DROP 01" },
    { "type": "text", "id": "link_label", "label": "Link-Text", "default": "View all" },
    { "type": "collection", "id": "collection", "label": "Kollektion", "info": "Leer = alle Produkte" },
    { "type": "range", "id": "limit", "label": "Anzahl Produkte", "min": 4, "max": 20, "step": 1, "default": 10 },
    { "type": "range", "id": "per_view", "label": "Produkte nebeneinander (Desktop)", "min": 3, "max": 6, "step": 1, "default": 5 },
    { "type": "select", "id": "badge", "label": "Badge", "default": "all", "options": [
      { "value": "all", "label": "Bei allen Produkten" },
      { "value": "tag", "label": "Nur bei Produkten mit Tag „neu“" },
      { "value": "none", "label": "Keins (Sale-Badge erscheint trotzdem)" }
    ] },
    { "type": "text", "id": "badge_label", "label": "Badge-Text", "default": "New" },
    { "type": "select", "id": "subtitle", "label": "Zweite Zeile", "default": "options", "options": [
      { "value": "options", "label": "Varianten (z. B. Farbe)" },
      { "value": "type", "label": "Produkttyp" },
      { "value": "vendor", "label": "Hersteller" },
      { "value": "none", "label": "Keine" }
    ] },
    { "type": "range", "id": "padding_top", "label": "Abstand oben", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Abstand unten", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 24 }
  ],
  "presets": [ { "name": "Produkt-Slider" } ]
}
{% endschema %}
