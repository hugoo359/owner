<section class="hero hero--{{ section.settings.height }}" data-slider data-interval="{{ section.settings.interval }}" style="--interval: {{ section.settings.interval }}s">
  {%- for block in section.blocks -%}
    {%- liquid
      if forloop.first
        assign ld = 'eager'
      else
        assign ld = 'lazy'
      endif
    -%}
    <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="slide{% if forloop.first %} on{% endif %}" {{ block.shopify_attributes }}>
      {%- if block.settings.image != blank -%}
        {{ block.settings.image | image_url: width: 2400 | image_tag: class: 'slide-img', sizes: '100vw', widths: '750, 1100, 1500, 1900, 2400', loading: ld, alt: block.settings.image.alt }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg slide-img' }}
      {%- endif -%}
      <span class="slide-overlay">
        {%- if block.settings.overlay_image != blank -%}
          {{ block.settings.overlay_image | image_url: width: 600 | image_tag: class: 'overlay-img', alt: '' }}
        {%- elsif block.settings.overlay_text != blank -%}
          <span class="logo">{{ block.settings.overlay_text }}</span>
        {%- endif -%}
      </span>
    </a>
  {%- endfor -%}
  {%- if section.blocks.size > 1 -%}
    <div class="dots">
      {%- for block in section.blocks -%}
        <button type="button" aria-label="Slide {{ forloop.index }}" class="{% if forloop.first %}on{% endif %}" data-slide="{{ forloop.index0 }}"><i></i></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero-Slideshow",
  "settings": [
    { "type": "select", "id": "height", "label": "Höhe", "default": "full", "options": [
      { "value": "full", "label": "Bildschirmhöhe" },
      { "value": "large", "label": "Groß" },
      { "value": "medium", "label": "Mittel" }
    ] },
    { "type": "range", "id": "interval", "label": "Wechsel alle", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 5 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Bild" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "image_picker", "id": "overlay_image", "label": "Logo in der Mitte (Bild)", "info": "Am besten ein weißes PNG" },
        { "type": "text", "id": "overlay_text", "label": "Text in der Mitte", "info": "Wird genutzt, wenn kein Logo-Bild gewählt ist" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    { "name": "Hero-Slideshow", "blocks": [ { "type": "slide" }, { "type": "slide" }, { "type": "slide" } ] }
  ]
}
{% endschema %}
