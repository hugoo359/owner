<section class="faq wrap" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px">
  {%- if section.settings.heading != blank -%}<h2 class="faq-title split-title" data-split>{{ section.settings.heading }}</h2>{%- endif -%}
  {%- if section.settings.intro != blank -%}<div class="faq-intro rte">{{ section.settings.intro }}</div>{%- endif -%}
  <div class="acc faq-list">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'group' -%}
          <h3 class="faq-group" {{ block.shopify_attributes }}>{{ block.settings.title }}</h3>
        {%- when 'question' -%}
          <details {{ block.shopify_attributes }}>
            <summary><span>{{ block.settings.question }}</span>{% render 'icon', icon: 'plus' %}</summary>
            <div class="body rte">{{ block.settings.answer }}</div>
          </details>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{%- liquid
  assign q_count = 0
  for block in section.blocks
    if block.type == 'question' and block.settings.question != blank
      assign q_count = q_count | plus: 1
    endif
  endfor
-%}
{%- if section.settings.schema and q_count > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- assign first = true -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'question' and block.settings.question != blank -%}
            {%- unless first %},{% endunless -%}
            {%- assign first = false -%}
            { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | json }} } }
          {%- endif -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "HÄUFIGE FRAGEN" },
    { "type": "richtext", "id": "intro", "label": "Einleitung" },
    { "type": "checkbox", "id": "schema", "label": "Fragen als FAQ für Google auszeichnen", "default": true },
    { "type": "range", "id": "padding_top", "label": "Abstand oben", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Abstand unten", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    { "type": "group", "name": "Zwischenüberschrift", "settings": [ { "type": "text", "id": "title", "label": "Titel", "default": "Bestellung & Versand" } ] },
    { "type": "question", "name": "Frage", "settings": [
      { "type": "text", "id": "question", "label": "Frage", "default": "Wie lange dauert der Versand?" },
      { "type": "richtext", "id": "answer", "label": "Antwort", "default": "<p>Bestellungen verschicken wir innerhalb von 1–2 Werktagen. Die Lieferung dauert in Deutschland meist 2–4 Werktage.</p>" }
    ] }
  ],
  "presets": [
    { "name": "FAQ", "blocks": [
      { "type": "group", "settings": { "title": "Bestellung & Versand" } },
      { "type": "question", "settings": { "question": "Wie lange dauert der Versand?", "answer": "<p>Bestellungen verschicken wir innerhalb von 1–2 Werktagen. Die Lieferung dauert in Deutschland meist 2–4 Werktage.</p>" } },
      { "type": "question", "settings": { "question": "Was kostet der Versand?", "answer": "<p>Ab 125 € Bestellwert ist der Versand kostenlos, darunter berechnen wir 4,90 €.</p>" } },
      { "type": "group", "settings": { "title": "Umtausch & Rückgabe" } },
      { "type": "question", "settings": { "question": "Kann ich meine Bestellung umtauschen?", "answer": "<p>Ja, innerhalb von 14 Tagen nach Erhalt kannst du ungetragene Artikel kostenlos umtauschen.</p>" } },
      { "type": "question", "settings": { "question": "Wann bekomme ich mein Geld zurück?", "answer": "<p>Sobald deine Rücksendung bei uns geprüft wurde, erstatten wir den Betrag innerhalb von 5 Werktagen auf dein ursprüngliches Zahlungsmittel.</p>" } }
    ] }
  ]
}
{% endschema %}
