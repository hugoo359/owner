{%- paginate collection.products by section.settings.per_page -%}
<section class="collection scheme-{{ section.settings.color_scheme }} section-pad">
  <div class="wrap">
    <header class="sec-head sec-head--center">
      <p class="eyebrow" data-reveal>{{ 'collection.products' | t: count: collection.products_count }}</p>
      <h1 class="h1" data-split>{{ collection.title }}</h1>
      {%- if collection.description != blank -%}<div class="rte sec-text" data-reveal>{{ collection.description }}</div>{%- endif -%}
    </header>
    <div class="fcol-grid" style="--cols: {{ section.settings.columns }}">
      {%- for product in collection.products -%}
        {% render 'fragrance-card', product: product, art: 'relic', quick_add: section.settings.quick_add %}
      {%- else -%}
        <p class="empty">{{ 'collection.empty' | t }}</p>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}{% render 'pagination', paginate: paginate %}{%- endif -%}
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Kollektion",
  "tag": "div",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Farbschema", "default": "dark", "options": [
      { "value": "dark", "label": "Nacht" }, { "value": "light", "label": "Pergament" }, { "value": "sand", "label": "Sand" }
    ] },
    { "type": "range", "id": "columns", "label": "Spalten (Desktop)", "min": 2, "max": 4, "step": 1, "default": 2 },
    { "type": "range", "id": "per_page", "label": "Produkte pro Seite", "min": 4, "max": 48, "step": 4, "default": 24 },
    { "type": "checkbox", "id": "quick_add", "label": "„In den Warenkorb“ direkt auf der Karte", "default": true }
  ]
}
{% endschema %}
