<div class="password-page">
  <div class="logo-link">{% render 'logo' %}</div>
  {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'customer', class: 'nl-inline' -%}
    <input type="hidden" name="contact[tags]" value="newsletter, password page">
    {%- if form.posted_successfully? -%}
      <p>{{ 'password.thanks' | t }}</p>
    {%- else -%}
      <input type="email" name="contact[email]" required placeholder="{{ 'newsletter.placeholder' | t }}" aria-label="{{ 'newsletter.label' | t }}">
      <button type="submit" class="atc">{{ 'password.notify' | t }}</button>
    {%- endif -%}
  {%- endform -%}
  <details class="pw-login">
    <summary>{{ 'password.enter_with_password' | t }}</summary>
    {%- form 'storefront_password' -%}
      {{ form.errors | default_errors }}
      <input type="password" name="password" required placeholder="{{ 'password.password' | t | upcase }}" aria-label="{{ 'password.password' | t }}">
      <button type="submit" class="atc">{{ 'password.enter' | t }}</button>
    {%- endform -%}
  </details>
</div>
{% schema %}
{ "name": "Passwort-Seite" }
{% endschema %}
