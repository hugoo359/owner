<div class="password-page">
  <div class="logo-link">{% render 'logo' %}</div>
  {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'customer', class: 'nl-inline' -%}
    <input type="hidden" name="contact[tags]" value="newsletter, password page">
    {%- if form.posted_successfully? -%}
      <p>Thanks! We'll let you know as soon as we launch.</p>
    {%- else -%}
      <input type="email" name="contact[email]" required placeholder="YOUR EMAIL ADDRESS" aria-label="Email address">
      <button type="submit" class="atc">NOTIFY ME</button>
    {%- endif -%}
  {%- endform -%}
  <details class="pw-login">
    <summary>Enter using password</summary>
    {%- form 'storefront_password' -%}
      {{ form.errors | default_errors }}
      <input type="password" name="password" required placeholder="PASSWORD" aria-label="Password">
      <button type="submit" class="atc">ENTER</button>
    {%- endform -%}
  </details>
</div>
{% schema %}
{ "name": "Passwort-Seite" }
{% endschema %}
