<div class="password-page">
  <div class="logo-link">{% render 'logo' %}</div>
  {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'customer', class: 'nl-inline' -%}
    <input type="hidden" name="contact[tags]" value="newsletter, password page">
    {%- if form.posted_successfully? -%}
      <p>Danke! Wir melden uns, sobald wir starten.</p>
    {%- else -%}
      <input type="email" name="contact[email]" required placeholder="DEINE E-MAIL-ADRESSE" aria-label="E-Mail-Adresse">
      <button type="submit" class="atc">BENACHRICHTIGEN</button>
    {%- endif -%}
  {%- endform -%}
  <details class="pw-login">
    <summary>Mit Passwort betreten</summary>
    {%- form 'storefront_password' -%}
      {{ form.errors | default_errors }}
      <input type="password" name="password" required placeholder="PASSWORT" aria-label="Passwort">
      <button type="submit" class="atc">BETRETEN</button>
    {%- endform -%}
  </details>
</div>
{% schema %}
{ "name": "Passwort-Seite" }
{% endschema %}
