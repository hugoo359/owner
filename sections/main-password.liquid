<section class="password-page scheme-dark">
  {%- if section.settings.image != blank -%}
    <div class="phero-media">{{ section.settings.image | image_url: width: 2400 | image_tag: class: 'hero-img', sizes: '100vw', widths: '750, 1100, 1500, 1920, 2400', alt: '' }}<div class="hero-shade" style="--shade: .45"></div></div>
  {%- else -%}
    <div class="phero-media">{% render 'fallback-art', art: 'dunes', class: 'hero-img', eager: true %}<div class="hero-shade" style="--shade: .35"></div></div>
  {%- endif -%}
  <div class="password-inner">
    {% render 'emblem', size: 34, animate: true %}
    <div class="logo-link">{% render 'logo', size: 'lg' %}</div>
    {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'customer', class: 'nl-form', id: 'PasswordNewsletter' -%}
      <input type="hidden" name="contact[tags]" value="newsletter, password page">
      {%- if form.posted_successfully? -%}
        <p class="form-msg form-msg--ok" role="status">{{ 'password.notify_success' | t }}</p>
      {%- else -%}
        <div class="nl-field">
          <label class="visually-hidden" for="PasswordNewsletter-email">{{ 'newsletter.email' | t }}</label>
          <input type="email" id="PasswordNewsletter-email" name="contact[email]" required autocomplete="email" placeholder="{{ 'newsletter.placeholder' | t }}">
          <button type="submit" class="nl-submit"><span>{{ 'password.notify_button' | t }}</span>{% render 'icon', icon: 'arrow-right' %}</button>
        </div>
      {%- endif -%}
    {%- endform -%}
    <details class="pw-login">
      <summary class="link-line">{{ 'password.enter' | t }}</summary>
      {%- form 'storefront_password', class: 'nl-form' -%}
        {{ form.errors | default_errors }}
        <div class="nl-field">
          <label class="visually-hidden" for="PasswordInput">{{ 'customer.password' | t }}</label>
          <input type="password" id="PasswordInput" name="password" required placeholder="{{ 'customer.password' | t }}">
          <button type="submit" class="nl-submit"><span>{{ 'password.enter_button' | t }}</span>{% render 'icon', icon: 'arrow-right' %}</button>
        </div>
      {%- endform -%}
    </details>
  </div>
</section>
{% schema %}
{
  "name": "Passwort-Seite",
  "settings": [ { "type": "image_picker", "id": "image", "label": "Hintergrundbild" } ]
}
{% endschema %}
