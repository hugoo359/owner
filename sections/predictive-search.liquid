<div id="PredictiveResults">
  {%- if predictive_search.performed -%}
    {%- assign products = predictive_search.resources.products -%}
    {%- if products.size > 0 -%}
      <ul class="ps-list" role="list">
        {%- for product in products limit: 4 -%}
          <li>
            <a class="ps-item" href="{{ product.url }}">
              <span class="ps-media">{%- if product.featured_media -%}{{ product.featured_media | image_url: width: 160 | image_tag: alt: '', loading: 'lazy', width: 80 }}{%- else -%}{% render 'fallback-art', art: 'relic' %}{%- endif -%}</span>
              <span class="ps-title">{{ product.title }}</span>
              {% render 'price', product: product %}
            </a>
          </li>
        {%- endfor -%}
      </ul>
      <a class="link-arrow" href="{{ routes.search_url }}?q={{ predictive_search.terms | url_encode }}&options%5Bprefix%5D=last"><span>{{ 'search.view_all' | t }}</span>{% render 'icon', icon: 'arrow-right' %}</a>
    {%- else -%}
      <p class="eyebrow">{{ 'search.no_results' | t }}</p>
    {%- endif -%}
  {%- endif -%}
</div>

{% schema %}
{ "name": "Suchvorschläge" }
{% endschema %}
