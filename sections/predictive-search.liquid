<div id="PredictiveResults">
  {%- if predictive_search.performed -%}
    {%- assign products = predictive_search.resources.products -%}
    {%- if products.size > 0 -%}
      <p>{{ 'search.preview_count' | t: count: products.size }}</p>
      <div class="grid" style="--cols: 4; margin: 24px 0 0">
        {%- for product in products limit: 4 -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
      <a class="search-all" href="{{ routes.search_url }}?q={{ predictive_search.terms | url_encode }}&options%5Bprefix%5D=last">{{ 'search.view_all' | t }}</a>
    {%- else -%}
      <p>{{ 'search.no_results_for' | t: terms: predictive_search.terms }}</p>
    {%- endif -%}
  {%- endif -%}
</div>

{% schema %}
{ "name": "Suchvorschläge" }
{% endschema %}
