[
  {
    "name": "theme_info",
    "theme_name": "Parfum",
    "theme_version": "1.0.0",
    "theme_author": "Eigenes Theme",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com/"
  },
  {
    "name": "Logo",
    "settings": [
      { "type": "image_picker", "id": "logo", "label": "Logo" },
      { "type": "range", "id": "logo_width", "label": "Logo-Breite", "min": 40, "max": 220, "step": 2, "unit": "px", "default": 64 },
      { "type": "image_picker", "id": "favicon", "label": "Favicon", "info": "Quadratisch, mindestens 32 × 32 px" }
    ]
  },
  {
    "name": "Farben",
    "settings": [
      { "type": "paragraph", "content": "Voreingestellt sind die Farben von 6PM: weißer Hintergrund, fast schwarzer Text, Hellblau als Akzent und Grün für Verfügbarkeit." },
      { "type": "color", "id": "color_background", "label": "Hintergrund", "default": "#ffffff" },
      { "type": "color", "id": "color_text", "label": "Text", "default": "#111111" },
      { "type": "color", "id": "color_accent", "label": "Akzent (aktiver Filter, Zur-Kasse-Button)", "default": "#9dd5ea" },
      { "type": "color", "id": "color_success", "label": "Erfolg (Verfügbarkeit, Versandbalken)", "default": "#2f7d14" }
    ]
  },
  {
    "name": "Duftfamilien & Farbkreise",
    "settings": [
      {
        "type": "paragraph",
        "content": "Ordnet Duftfamilien (Farbpunkt im Kollektionsfilter), Duftnamen (Farbkreis bei Düften einer Linie) und Farben einem Farbton zu. Eine Zeile pro Eintrag im Format Name: #hex. In Shopify hinterlegte Swatches und das Metafeld custom.color_swatch werden bevorzugt."
      },
      {
        "type": "textarea",
        "id": "color_map",
        "label": "Farbzuordnung",
        "default": "Blumig: #f3c6d3\nFloral: #f3c6d3\nPudrig: #ead7d1\nFruchtig: #e8798a\nGourmand: #c69c72\nSüß: #c69c72\nFrisch: #bfe5da\nZitrisch: #f4d35e\nAquatisch: #9dd5ea\nGrün: #7fae6e\nFougère: #6f8f72\nChypre: #6b7a3a\nHolzig: #8a6446\nWoody: #8a6446\nWürzig: #a3472a\nOrientalisch: #b0602c\nAmber: #c98a3a\nLedrig: #5a3a2a\nOud: #3b2a20\nMoschus: #e8dfcf\nSchwarz: #141414\nWeiß: #f7f7f5\nGold: #c9a227\nSilber: #c0c0c0\nRosa: #f3a9c4\nRot: #c8102e\nBlau: #3e6cb3"
      }
    ]
  },
  {
    "name": "Warenkorb",
    "settings": [
      { "type": "number", "id": "free_shipping_threshold", "label": "Kostenloser Versand ab (Betrag)", "default": 125, "info": "0 blendet den Fortschrittsbalken aus. Die echten Versandkosten stellst du unter Einstellungen > Versand ein." },
      { "type": "text", "id": "shipping_label", "label": "Angezeigte Versandkosten unter dem Mindestbetrag", "default": "4,90 €" },
      { "type": "text", "id": "cart_note_title", "label": "Hinweis-Titel", "default": "GUTE WAHL!" },
      { "type": "text", "id": "cart_note_text", "label": "Hinweis-Text", "default": "Hier sind deine Düfte:" },
      { "type": "collection", "id": "cart_upsell_collection", "label": "„Passt dazu“-Kollektion im Warenkorb" }
    ]
  },
  {
    "name": "Produktseite",
    "settings": [
      { "type": "text", "id": "tax_text", "label": "Steuerhinweis", "default": "inkl. MwSt." },
      { "type": "text", "id": "in_stock_text", "label": "Verfügbar-Text", "default": "Auf Lager." },
      { "type": "text", "id": "delivery_text", "label": "Lieferzeit-Text", "default": "Lieferung in 2–4 Tagen" },
      { "type": "text", "id": "sold_out_text", "label": "Ausverkauft-Text", "default": "Ausverkauft." }
    ]
  },
  {
    "name": "Animationen",
    "settings": [
      { "type": "checkbox", "id": "anim_reveal", "label": "Inhalte beim Scrollen einblenden", "default": true },
      { "type": "checkbox", "id": "anim_page_transitions", "label": "Weiche Seitenwechsel", "default": true },
      { "type": "checkbox", "id": "anim_fly_to_cart", "label": "Produktbild fliegt in den Warenkorb", "default": true },
      { "type": "checkbox", "id": "quick_add", "label": "Schnell-Hinzufügen auf Produktkarten", "default": true, "info": "Größen (z. B. 50 ml) erscheinen beim Hovern über dem Produktbild." },
      { "type": "checkbox", "id": "respect_reduced_motion", "label": "Systemeinstellung „Bewegung reduzieren“ beachten", "default": false, "info": "Wenn aktiv, sehen Besucher mit dieser Systemeinstellung keine Animationen." }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      { "type": "text", "id": "social_instagram", "label": "Instagram-Link" },
      { "type": "text", "id": "social_youtube", "label": "YouTube-Link" },
      { "type": "text", "id": "social_tiktok", "label": "TikTok-Link" },
      { "type": "text", "id": "social_whatsapp", "label": "WhatsApp-Link" }
    ]
  }
]
