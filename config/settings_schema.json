[
  {
    "name": "theme_info",
    "theme_name": "Sablier",
    "theme_version": "2.0.0",
    "theme_author": "Eigenes Theme",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com/"
  },
  {
    "name": "Logo",
    "settings": [
      { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Ohne Logo-Bild zeigt das Theme den Shopnamen als Schriftzug mit Sanduhr-Zeichen." },
      { "type": "range", "id": "logo_width", "label": "Logo-Breite", "min": 60, "max": 260, "step": 2, "unit": "px", "default": 132 },
      { "type": "checkbox", "id": "logo_emblem", "label": "Sanduhr-Zeichen neben dem Schriftzug", "default": true },
      { "type": "image_picker", "id": "favicon", "label": "Favicon", "info": "Quadratisch, mindestens 32 × 32 px" }
    ]
  },
  {
    "name": "Farben",
    "settings": [
      { "type": "header", "content": "Farbschema „Nacht“ (Standard)" },
      { "type": "color", "id": "color_background", "label": "Hintergrund", "default": "#0d0c0a" },
      { "type": "color", "id": "color_text", "label": "Text", "default": "#ece4d6" },
      { "type": "header", "content": "Farbschema „Pergament“" },
      { "type": "color", "id": "color_background_alt", "label": "Hintergrund", "default": "#efe8dc" },
      { "type": "color", "id": "color_text_alt", "label": "Text", "default": "#191612" },
      { "type": "header", "content": "Farbschema „Sand“" },
      { "type": "color", "id": "color_sand", "label": "Hintergrund", "default": "#2a2219" },
      { "type": "header", "content": "Akzent" },
      { "type": "color", "id": "color_accent", "label": "Akzent (Gold, Linien, Hervorhebungen)", "default": "#c6a46a" }
    ]
  },
  {
    "name": "Typografie",
    "settings": [
      { "type": "paragraph", "content": "Überschriften: Cormorant Garamond, Fließtext: Jost. Beide Schriften liegen im Theme (Open Font License)." },
      { "type": "range", "id": "heading_scale", "label": "Größe der Überschriften", "min": 80, "max": 130, "step": 5, "unit": "%", "default": 100 },
      { "type": "checkbox", "id": "heading_uppercase", "label": "Überschriften in Großbuchstaben", "default": true },
      { "type": "range", "id": "button_radius", "label": "Ecken der Buttons", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 0 }
    ]
  },
  {
    "name": "Preise",
    "settings": [
      { "type": "checkbox", "id": "currency_code_enabled", "label": "Währungscode anzeigen (z. B. „$155.00 USD“)", "default": false }
    ]
  },
  {
    "name": "Produktstatus",
    "settings": [
      { "type": "paragraph", "content": "Ausverkauft wird automatisch aus dem Lagerbestand in Shopify erkannt. Für noch nicht erschienene Düfte vergibst du im Produkt das Tag unten – dann steht dort „Coming soon“ statt „Sold out“. Ein Datum zeigt das Theme nur, wenn du es selbst einträgst." },
      { "type": "text", "id": "coming_soon_tag", "label": "Produkt-Tag für „Coming soon“", "default": "coming-soon" },
      { "type": "checkbox", "id": "notify_enabled", "label": "„Benachrichtigen“-Formular bei nicht verfügbaren Produkten", "default": true, "info": "Nutzt Shopifys Kundenformular. Einträge erscheinen unter Kunden mit dem Tag notify-<produkt-handle>." }
    ]
  },
  {
    "name": "Warenkorb",
    "settings": [
      { "type": "number", "id": "free_shipping_threshold", "label": "Kostenloser Versand ab (Betrag in Shop-Währung)", "default": 0, "info": "0 blendet den Fortschrittsbalken aus. Die echten Versandkosten stellst du unter Einstellungen > Versand ein." },
      { "type": "checkbox", "id": "cart_note_enabled", "label": "Bestellnotiz im Warenkorb erlauben", "default": false },
      { "type": "collection", "id": "cart_upsell_collection", "label": "Empfehlungen im Warenkorb aus Kollektion", "info": "Leer = keine Empfehlungen" }
    ]
  },
  {
    "name": "Animationen",
    "settings": [
      { "type": "checkbox", "id": "anim_reveal", "label": "Inhalte beim Scrollen einblenden", "default": true },
      { "type": "checkbox", "id": "anim_page_transitions", "label": "Weiche Seitenwechsel", "default": true },
      { "type": "checkbox", "id": "anim_fly_to_cart", "label": "Produktbild fliegt in den Warenkorb", "default": true },
      { "type": "checkbox", "id": "respect_reduced_motion", "label": "Systemeinstellung „Bewegung reduzieren“ beachten", "default": true }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      { "type": "text", "id": "social_instagram", "label": "Instagram-Link" },
      { "type": "text", "id": "social_tiktok", "label": "TikTok-Link" },
      { "type": "text", "id": "social_facebook", "label": "Facebook-Link" },
      { "type": "text", "id": "social_youtube", "label": "YouTube-Link" },
      { "type": "text", "id": "social_x", "label": "X-Link" }
    ]
  }
]
